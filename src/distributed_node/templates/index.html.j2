{% extends "base.html.j2" %}
{% block title %}{{ node.display_name }} · Inicio{% endblock %}
{% block header_extra %}
<div class="current-time">
  <strong>Última Ejecución</strong>
  <time datetime="{{ updated_at|local_iso(node.logical_location.timezone) }}">{{ updated_at|local_datetime_short(node.logical_location.timezone) }}</time>
</div>
{% endblock %}
{% macro economic_band(economy) -%}
<section class="economic-band" aria-label="Indicadores económicos {{ economy.provider_label if economy else 'Proveedor económico' }}">
  {% if economy and economy.status == "available" %}
  <div class="economic-band-date">{{ economy.date }}</div>
  <div class="economic-indicators" aria-label="Indicadores principales">
    {% for item in economy.indicators %}
    <article class="economic-item">
      <span>{{ item.label }}</span>
      <strong>{{ item.value }}</strong>
    </article>
    {% endfor %}
    <span class="economic-divider">Indicadores complementarios</span>
    {% for item in economy.inflation %}
    <article class="economic-item economic-item-compact">
      <span>{{ item.label }}</span>
      <strong>{{ item.value }}</strong>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="economic-band-date">Indicadores económicos</div>
  <p class="economic-unavailable">
    No fue posible actualizar los indicadores desde {{ economy.provider_label if economy else "el proveedor económico" }} durante este render.
  </p>
  {% endif %}
</section>
{%- endmacro %}
{% macro station_snapshot_card(label, name, updated_at, metrics, source_url=None, status="available", ephemerides=None) -%}
<section class="station-snapshot-card observation-card">
  <div class="station-snapshot-heading">
    <p class="eyebrow">{{ label }}</p>
    <h2>{% if source_url %}<a href="{{ source_url }}" rel="external">{{ name }}</a>{% else %}{{ name }}{% endif %}</h2>
    <p>Última lectura:  {{ updated_at if updated_at else "—" }}</p>
  </div>
  {% if status == "available" and metrics %}
  <div class="redmeteo-observation-grid station-metric-grid" aria-label="Datos actuales de {{ name }}">
    {% for metric in metrics %}
    <article class="redmeteo-metric">
      <span class="redmeteo-icon" role="img" aria-label="{{ metric.icon_label if metric.icon_label else metric.label }}">{{ metric.icon }}</span>
      <span class="redmeteo-label">{{ metric.label }}</span>
      {% if metric.label == "Viento" and " · " in metric.value %}
      {% set wind_parts = metric.value.split(" · ", 1) %}
      <strong class="redmeteo-wind-value">
        <span class="redmeteo-wind-speed">{{ wind_parts[0] }}</span>
        <span class="redmeteo-wind-direction">{{ wind_parts[1] }}</span>
      </strong>
      {% else %}
      <strong>{{ metric.value }}</strong>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="external-note">Sin lectura disponible durante este render.</p>
  {% endif %}
  {% if status == "available" and ephemerides %}
  <div class="station-ephemerides">
    <div class="station-ephemerides-table-wrap" tabindex="0" aria-label="Tabla desplazable de efemérides de {{ name }}">
      <table class="station-ephemerides-table">
        <thead>
          <tr>
            <th scope="col">Día</th>
            <th scope="col">🌡️ Temp.</th>
            <th scope="col">💧 Hum.</th>
            <th scope="col">💨 Viento</th>
            <th scope="col">🌧️ Lluvia</th>
            <th scope="col">☀️ Radiación</th>
          </tr>
        </thead>
        <tbody>
        {% for item in ephemerides %}
          <tr>
            <td>{{ item.label }}<small>{{ item.date }}</small></td>
            <td>{{ item.temperature }}</td>
            <td>{{ item.humidity }}</td>
            <td>{{ item.wind }}</td>
            <td>{{ item.rain }}</td>
            <td>{{ item.radiation }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}
</section>
{%- endmacro %}
{% block content %}
<style>
  .index-network-panel {
    --sonantia-n01:#4ad4c6;
    --sonantia-n02:#63b3ff;
    --sonantia-n03:#b899ff;
    --sonantia-n04:#f3b95f;
    display:grid;
    gap:.72rem;
    margin-top:.15rem;
    border-color:rgba(99, 179, 255, .18);
    background:
      radial-gradient(circle at 92% 0, rgba(74, 212, 198, .1), transparent 22rem),
      linear-gradient(145deg, rgba(18, 29, 46, .98), rgba(10, 17, 29, .98));
  }
  .index-network-heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.55rem 1rem; align-items:end; }
  .index-network-heading .eyebrow { justify-self:start; text-align:left; }
  .index-network-heading h2 { margin:.1rem 0 0; font-size:1.18rem; }
  .index-network-caption { margin:0; color:var(--muted); font-size:.66rem; }
  .index-network-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:.48rem; }
  .index-network-card {
    --node-color:var(--sonantia-n02);
    display:grid;
    gap:.3rem;
    min-width:0;
    padding:.62rem;
    border:1px solid color-mix(in srgb, var(--node-color) 24%, transparent);
    border-top:2px solid var(--node-color);
    border-radius:.55rem;
    background:rgba(6, 12, 21, .55);
  }
  .index-network-n02 { --node-color:var(--sonantia-n02); }
  .index-network-n03 { --node-color:var(--sonantia-n03); }
  .index-network-n04 { --node-color:var(--sonantia-n04); }
  .index-network-card-head { display:flex; justify-content:space-between; gap:.4rem; align-items:flex-start; }
  .index-network-id { display:inline-flex; align-items:center; gap:.3rem; color:var(--node-color); font-size:.7rem; font-weight:900; letter-spacing:.05em; }
  .index-network-id::before { content:""; width:.44rem; height:.44rem; border-radius:50%; background:var(--node-color); box-shadow:0 0 .5rem var(--node-color); }
  .index-network-state { padding:.1rem .3rem; border-radius:999px; color:var(--node-color); background:color-mix(in srgb, var(--node-color) 10%, transparent); font-size:.53rem; font-weight:800; text-transform:lowercase; white-space:nowrap; }
  .index-network-card strong { overflow:hidden; color:#e6f1fc; font-size:.8rem; text-overflow:ellipsis; white-space:nowrap; }
  .index-network-card small { color:var(--muted); font-size:.61rem; line-height:1.3; }
  .index-network-metrics { display:flex; flex-wrap:wrap; gap:.25rem; }
  .index-network-metric { padding:.12rem .3rem; border:1px solid color-mix(in srgb, var(--node-color) 16%, transparent); border-radius:999px; color:#bdd0e2; background:color-mix(in srgb, var(--node-color) 5%, transparent); font-size:.54rem; white-space:nowrap; }
  .index-network-empty { grid-column:1 / -1; margin:0; color:var(--muted); font-size:.72rem; }
  @media (max-width:68rem) { .index-network-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
  @media (max-width:42rem) { .index-network-grid { grid-template-columns:1fr; } }
</style>
{{ economic_band(economy) }}
<div class="station-summary-grid{% if weather_source_cards|length == 1 %} station-summary-grid-single{% endif %}" aria-label="Fuentes meteorológicas de referencia">
  {% for source in weather_source_cards %}
  {{ station_snapshot_card(
    source.label,
    source.name,
    source.updated_at_local,
    source.metrics,
    source.source_url,
    source.status,
    source.ephemerides
  ) }}
  {% else %}
  <section class="station-snapshot-card observation-card">
    <div class="station-snapshot-heading">
      <p class="eyebrow">Proveedor meteorológico</p>
      <h2>Sin fuente configurada</h2>
    </div>
    <p class="external-note">No existe una fuente meteorológica activa para este nodo.</p>
  </section>
  {% endfor %}
</div>
<div class="home-observation-grid">
  <section class="weather-history observation-card observation-card-main">
    <div class="panel-heading weather-panel-heading">
      <h2 class="weather-source-title">Condición Climática {{ node.display_name }}</h2>
      <div class="weather-current-condition" aria-label="Condición actual obtenida desde Open-Meteo">
        <span class="weather-condition-icon" role="img" aria-label="{{ current_condition.icon_label }}">{{ current_condition.icon }}</span>
        <span class="weather-condition-copy">
          <span>Condición</span>
          <strong>{{ current_condition.condition }}</strong>
        </span>
        <a href="{{ current_condition.source_url }}" rel="external">{{ current_condition.source_label }}</a>
        <time>Actualizada: {{ current_condition.updated_at_local }}</time>
      </div>
    </div>
    {% if weather_measurements %}
    {% if weather_chart %}
    <aside class="weather-composite" data-weather-composite aria-labelledby="weather-evolution-title">
      <div class="weather-composite-heading">
        <div>
          <span class="eyebrow">{% if weather.measurement_source_count > 1 %}Promedio de las fuentes disponibles{% else %}Datos del proveedor meteorológico{% endif %}</span>
          <h3 id="weather-evolution-title">Evolución meteorológica · últimas 72 horas</h3>
        </div>
        <div class="weather-composite-legend" aria-label="Leyenda de la gráfica">
          <span class="legend-temperature">Temperatura</span>
          <span class="legend-humidity">Humedad</span>
          <span class="legend-pressure">Presión</span>
          <span class="legend-precipitation">Precipitación</span>
          <span class="legend-radiation">Radiación</span>
        </div>
      </div>
      <div class="weather-composite-viewport">
        <svg
          class="weather-composite-svg"
          viewBox="0 0 {{ weather_chart.viewbox_width }} {{ weather_chart.viewbox_height }}"
          preserveAspectRatio="xMinYMin meet"
          role="img"
          aria-label="Evolución de temperatura, humedad, presión, precipitación y radiación solar durante las últimas 72 horas"
          tabindex="0"
        >
          <g class="weather-chart-grid" aria-hidden="true">
            {% for tick in weather_chart.ticks %}
            <line x1="{{ tick.x }}" y1="{{ weather_chart.grid_top }}" x2="{{ tick.x }}" y2="{{ weather_chart.grid_bottom }}"></line>
            <text x="{{ tick.x }}" y="{{ weather_chart.tick_label_y }}" text-anchor="middle">{{ tick.label }}</text>
            <text x="{{ tick.x }}" y="{{ weather_chart.tick_time_y }}" text-anchor="middle">{{ tick.time }}</text>
            {% endfor %}
            {% for marker in weather_chart.day_markers %}
            <line class="weather-day-marker" x1="{{ marker.x }}" y1="{{ weather_chart.grid_top }}" x2="{{ marker.x }}" y2="{{ weather_chart.grid_bottom }}"></line>
            {% endfor %}
            {% for separator in weather_chart.separator_y %}
            <line x1="{{ weather_chart.plot_left }}" y1="{{ separator }}" x2="{{ weather_chart.plot_right }}" y2="{{ separator }}"></line>
            {% endfor %}
          </g>

          <g class="weather-band-labels" aria-hidden="true">
            <text x="{{ weather_chart.plot_left }}" y="14">Temperatura · humedad</text>
            <text x="{{ weather_chart.plot_left }}" y="119">Presión</text>
            <text x="{{ weather_chart.plot_left }}" y="195">Precipitación · radiación</text>

            <text class="weather-axis-value temperature-text" x="{{ weather_chart.plot_left }}" y="32">{{ '%.1f'|format(weather_chart.ranges.temperature[1]) }} °C</text>
            <text class="weather-axis-value temperature-text" x="{{ weather_chart.plot_left }}" y="100">{{ '%.1f'|format(weather_chart.ranges.temperature[0]) }} °C</text>
            <text class="weather-axis-value humidity-text" x="{{ weather_chart.plot_right }}" y="32" text-anchor="end">{{ '%.0f'|format(weather_chart.ranges.humidity[1]) }} %</text>
            <text class="weather-axis-value humidity-text" x="{{ weather_chart.plot_right }}" y="100" text-anchor="end">{{ '%.0f'|format(weather_chart.ranges.humidity[0]) }} %</text>

            <text class="weather-axis-value pressure-text" x="{{ weather_chart.plot_left }}" y="132">{{ '%.1f'|format(weather_chart.ranges.pressure[1]) }} hPa</text>
            <text class="weather-axis-value pressure-text" x="{{ weather_chart.plot_left }}" y="175">{{ '%.1f'|format(weather_chart.ranges.pressure[0]) }} hPa</text>

            <text class="weather-axis-value precipitation-text" x="{{ weather_chart.plot_left }}" y="210">{{ '%.1f'|format(weather_chart.ranges.precipitation[1]) }} mm</text>
            <text class="weather-axis-value radiation-text" x="{{ weather_chart.plot_right }}" y="210" text-anchor="end">{{ '%.0f'|format(weather_chart.ranges.radiation[1]) }} W/m²</text>
          </g>

          <g class="weather-series-radiation" aria-hidden="true">
            {% for path in weather_chart.radiation_areas %}<path class="radiation-area" d="{{ path }}"></path>{% endfor %}
            {% for points in weather_chart.radiation_segments %}<polyline class="radiation-line" points="{{ points }}"></polyline>{% endfor %}
          </g>
          <g class="weather-series-precipitation" aria-hidden="true">
            {% for bar in weather_chart.precipitation_bars %}
            <rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}" rx="1.5"></rect>
            {% endfor %}
          </g>
          <g class="weather-series-pressure" aria-hidden="true">
            {% for points in weather_chart.pressure_segments %}<polyline points="{{ points }}"></polyline>{% endfor %}
          </g>
          <g class="weather-series-temperature" aria-hidden="true">
            {% for points in weather_chart.temperature_segments %}<polyline points="{{ points }}"></polyline>{% endfor %}
          </g>
          <g class="weather-series-humidity" aria-hidden="true">
            {% for points in weather_chart.humidity_segments %}<polyline points="{{ points }}"></polyline>{% endfor %}
          </g>

          <line class="weather-chart-cursor" x1="0" y1="{{ weather_chart.grid_top }}" x2="0" y2="{{ weather_chart.grid_bottom }}" hidden></line>
        </svg>
        <div class="weather-chart-tooltip" role="status" aria-live="polite" hidden>
          <strong data-tooltip-time></strong>
          <span><i class="tooltip-temperature"></i>Temperatura <b data-tooltip-temperature>—</b></span>
          <span><i class="tooltip-humidity"></i>Humedad <b data-tooltip-humidity>—</b></span>
          <span><i class="tooltip-pressure"></i>Presión <b data-tooltip-pressure>—</b></span>
          <span><i class="tooltip-precipitation"></i>Precipitación <b data-tooltip-precipitation>—</b></span>
          <span><i class="tooltip-radiation"></i>Radiación <b data-tooltip-radiation>—</b></span>
          <small data-tooltip-sources></small>
        </div>
      </div>
      <div class="weather-composite-latest" aria-label="Últimos valores disponibles">
        <span>Temperatura <strong>{% if weather_chart.latest.temperature is not none %}{{ '%.1f'|format(weather_chart.latest.temperature) }} °C{% else %}—{% endif %}</strong></span>
        <span>Humedad <strong>{% if weather_chart.latest.humidity is not none %}{{ '%.1f'|format(weather_chart.latest.humidity) }} %{% else %}—{% endif %}</strong></span>
        <span>Presión <strong>{% if weather_chart.latest.pressure is not none %}{{ '%.1f'|format(weather_chart.latest.pressure) }} hPa{% else %}—{% endif %}</strong></span>
        <span>Precipitación <strong>{% if weather_chart.latest.precipitation is not none %}{{ '%.1f'|format(weather_chart.latest.precipitation) }} mm{% else %}—{% endif %}</strong></span>
        <span>Radiación <strong>{% if weather_chart.latest.radiation is not none %}{{ '%.0f'|format(weather_chart.latest.radiation) }} W/m²{% else %}—{% endif %}</strong></span>
      </div>
      <script type="application/json" class="weather-composite-data">{{ weather_chart.points|tojson }}</script>
    </aside>
    {% else %}
    <p class="empty-state">Aún no hay valores disponibles para graficar.</p>
    {% endif %}
    <div class="weather-table-wrap" tabindex="0" aria-label="Tabla desplazable de mediciones meteorológicas">
      <table class="weather-table">
        <colgroup>
          <col class="weather-col-icon">
          <col class="weather-col-condition">
          <col class="weather-col-temperature">
          <col class="weather-col-humidity">
          <col class="weather-col-precipitation">
          <col class="weather-col-pressure">
          <col class="weather-col-radiation">
          <col class="weather-col-time">
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Clima</th>
            <th scope="col">Condición</th>
            <th scope="col">Temp.</th>
            <th scope="col">Hum.</th>
            <th scope="col">Lluvia hoy</th>
            <th scope="col">Presión</th>
            <th scope="col">Radiación</th>
            <th scope="col">Hora local</th>
          </tr>
        </thead>
        <tbody>
        {% for item in weather_table_measurements %}
          <tr>
            <td><span class="weather-icon" role="img" aria-label="{{ item.icon_label }}">{{ item.icon }}</span></td>
            <td>{{ item.condition }}</td>
            <td>{% if item.temperature_c is not none %}{{ "%.2f"|format(item.temperature_c) }} °C{% else %}—{% endif %}</td>
            <td>{% if item.relative_humidity_percent is not none %}{{ "%.2f"|format(item.relative_humidity_percent) }} %{% else %}—{% endif %}</td>
            <td>{% if item.precipitation_mm is not none %}{{ "%.2f"|format(item.precipitation_mm) }} mm{% else %}—{% endif %}</td>
            <td>{% if item.pressure_hpa is not none %}{{ "%.2f"|format(item.pressure_hpa) }} hPa{% else %}—{% endif %}</td>
            <td>{% if item.solar_radiation_wm2 is not none %}{{ "%.2f"|format(item.solar_radiation_wm2) }} W/m²{% else %}—{% endif %}</td>
            <td><time datetime="{{ item.local_time|local_iso(node.logical_location.timezone) }}">{{ item.local_time|local_datetime_short(node.logical_location.timezone) }}</time></td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="empty-state">Todavía no hay mediciones meteorológicas registradas por {{ node.node_id }}.</p>
    {% endif %}
  </section>
</div>
<section class="seismic-card seismic-wide-card observation-card">
  <div class="panel-heading">
    <p class="eyebrow">Registro geofísico</p>
    <div>
      <h2>Actividad geológica · {{ geology.region_label if geology and geology.region_label else node.logical_location.country }} · últimas {{ geology.window_hours if geology and geology.window_hours else 24 }} horas</h2>
      <p>
        {% if geology and geology.status == "available" %}
        {{ geology.count }} evento{% if geology.count != 1 %}s{% endif %} reportado{% if geology.count != 1 %}s{% endif %}
        por {{ geology.provider_label if geology.provider_label else "el proveedor geológico configurado" }}.
        {% else %}
        No fue posible consultar {{ geology.provider_label if geology and geology.provider_label else "el proveedor geológico" }} durante este render.
        {% endif %}
      </p>
    </div>
  </div>
  {% if geology and geology.status == "available" and geology.events %}
  <div class="seismic-table-wrap" tabindex="0" aria-label="Tabla desplazable de sismos recientes">
    <table class="seismic-table">
      <thead>
        <tr>
          <th scope="col">Hora local</th>
          <th scope="col">Magnitud</th>
          <th scope="col">Prof.</th>
          <th scope="col">Ubicación</th>
          <th scope="col">Coordenadas</th>
          <th scope="col">Tipo</th>
        </tr>
      </thead>
      <tbody>
        {% for event in geology.events %}
        <tr class="{% if event.felt %}seismic-felt-row{% endif %}">
          <td><time>{{ event.local_time }}</time></td>
          <td><strong>M {{ event.magnitude }}</strong></td>
          <td>{{ event.depth }}</td>
          <td>{{ event.location }}</td>
          <td><span class="coordinates">{{ event.coordinates }}</span></td>
          <td>{% if event.felt %}<span class="felt-pill">percibido</span>{% else %}<span class="quiet-pill">registrado</span>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% elif geology and geology.status == "available" %}
  <p class="empty-state">No hay sismos publicados dentro de la ventana informada.</p>
  {% endif %}
  {% if geology and geology.source_url %}<p class="external-link"><a href="{{ geology.source_url }}" rel="external">Abrir fuente oficial</a></p>{% endif %}
</section>
<section class="astronomy-card observation-card">
  <div class="panel-heading">
    <p class="eyebrow">Referencia astronómica</p>
    <div>
      <h2><a href="https://ssd.jpl.nasa.gov/horizons/" rel="external">NASA - JPL Horizons</a></h2>
      <p>
        {% if astronomy and astronomy.status == "available" %}
		Se consultó API NASA/JPL Horizons para calcular la posición de {{ astronomy.available_count }} objetos astronómicos desde el observador local
        {% else %}
        No fue posible consultar NASA/JPL Horizons durante este render.
        {% endif %}
      </p>
    </div>
  </div>
  {% if astronomy and astronomy.earth %}
  <div class="earth-context-grid" aria-label="Contexto terrestre de la consulta Horizons">
    <article class="earth-context-card">
      <span>Observador</span>
      <strong>{{ astronomy.observer.name }}</strong>
    </article>
    <article class="earth-context-card">
      <span>Instante local</span>
      <strong>{{ astronomy.earth.instant_local }}</strong>
      <small>UTC {{ astronomy.earth.instant_utc }}</small>
    </article>
    <article class="earth-context-card">
      <span>Tierra</span>
      <strong>{{ astronomy.earth.frame }}</strong>
      <small>Origen {{ astronomy.earth.origin }} · JD {{ astronomy.earth.julian_day }}</small>
    </article>
    <article class="earth-context-card earth-vector-card">
      <span>Vector posición</span>
      <strong>X {{ astronomy.earth.position.x }}</strong>
      <small>Y {{ astronomy.earth.position.y }} · Z {{ astronomy.earth.position.z }}</small>
    </article>
    <article class="earth-context-card earth-vector-card">
      <span>Vector velocidad</span>
      <strong>VX {{ astronomy.earth.velocity.vx }}</strong>
      <small>VY {{ astronomy.earth.velocity.vy }} · VZ {{ astronomy.earth.velocity.vz }}</small>
    </article>
  </div>
  {% endif %}
  {% if astronomy and astronomy.status == "available" and astronomy.targets %}
  <div class="astronomy-table-wrap" tabindex="0" aria-label="Tabla desplazable de posiciones astronómicas">
    <table class="astronomy-table">
      <thead>
        <tr>
          <th scope="col">Astro</th>
          <th scope="col">Tipo</th>
          <th scope="col">Elevación</th>
          <th scope="col">Azimut</th>
          <th scope="col">RA</th>
          <th scope="col">DEC</th>
          <th scope="col">Magnitud</th>
          <th scope="col">Distancia</th>
          <th scope="col">Visibilidad</th>
        </tr>
      </thead>
      <tbody>
        {% for target in astronomy.targets %}
        <tr class="{% if target.status != 'available' %}astronomy-unavailable-row{% endif %}">
          <td><span class="astro-icon" aria-hidden="true">{{ target.icon }}</span> <strong>{{ target.name }}</strong></td>
          <td>{{ target.kind }}</td>
          <td>{{ target.elevation if target.status == "available" else "—" }}</td>
          <td>{{ target.azimuth if target.status == "available" else "—" }}</td>
          <td>{{ target.ra if target.status == "available" else "—" }}</td>
          <td>{{ target.dec if target.status == "available" else "—" }}</td>
          <td>{{ target.magnitude_text if target.status == "available" else "—" }}</td>
          <td>{{ target.range_text if target.status == "available" else "—" }}</td>
          <td>{{ target.visibility if target.status == "available" else "sin datos" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  <p class="external-link"><a href="{{ astronomy.source_url if astronomy else 'https://ssd.jpl.nasa.gov/horizons/' }}" rel="external">Abrir NASA/JPL Horizons</a></p>
</section>
<section class="rail-card identity-card identity-under-astronomy">
  <h2>Identidad y estado</h2>
  <p><span class="status {{ status.status }}">{{ status.status }}</span></p>
  <dl>
    <dt>ID</dt><dd>{{ node.node_id }}</dd>
    <dt>Rol</dt><dd>{{ node.node_role }}</dd>
    <dt>Ubicación</dt><dd>{{ node.logical_location.city }}, {{ node.logical_location.country }} · {{ node.logical_location.zone }}</dd>
    <dt>Zona horaria</dt><dd>{{ node.logical_location.timezone }}</dd>
    <dt>Protocolo</dt><dd>{{ node.protocol_version }}</dd>
  </dl>
</section>
<section class="index-network-panel" aria-labelledby="index-network-title">
  <div class="index-network-heading">
    <div>
      <p class="eyebrow">Panorama distribuido</p>
      <h2 id="index-network-title">Nodos de Sonantia</h2>
    </div>
    <p id="index-network-caption" class="index-network-caption">Sonantia Network · cargando topología</p>
  </div>
  <div id="index-network-nodes" class="index-network-grid" aria-live="polite">
    <p class="index-network-empty">Cargando nodos…</p>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script>
{% include "weather-chart.js.j2" %}

(() => {
  const target = document.getElementById("index-network-nodes");
  const caption = document.getElementById("index-network-caption");
  if (!target || !caption) return;

  const localNode = {
    node_id: {{ node.node_id|tojson }},
    name: {{ node.display_name|tojson }},
    city: {{ node.logical_location.city|tojson }},
    platform: {{ node.infrastructure.provider|tojson }},
  };
  const fallbackNodes = [
    localNode,
    {% for card in peer_cards %}
    {
      node_id: {{ card.peer.node_id|tojson }},
      name: {{ card.peer.display_name|tojson }},
      city: {{ card.peer.display_name|replace("Nodo ", "")|tojson }},
      platform: null,
    },
    {% endfor %}
  ];

  const loadJson = async (url) => {
    const response = await fetch(url, {cache:"no-store"});
    if (!response.ok) throw new Error(`${url}: HTTP ${response.status}`);
    return response.json();
  };
  const safeLoad = async (url, fallback = {}) => {
    try { return await loadJson(url); }
    catch (error) { console.warn(`No fue posible cargar ${url}`, error); return fallback; }
  };
  const element = (tag, className, value) => {
    const item = document.createElement(tag);
    if (className) item.className = className;
    if (value !== undefined && value !== null) item.textContent = String(value);
    return item;
  };

  Promise.all([
    safeLoad("network.json"),
    safeLoad("inventory.json"),
    safeLoad("feed.json"),
    safeLoad("sonantia-status.json"),
  ]).then(async ([network, inventory, feed, status]) => {
    const configured = Array.isArray(network.nodes) ? network.nodes : [];
    const nodes = fallbackNodes.map((fallback) => ({
      ...fallback,
      ...(configured.find((item) => item.node_id === fallback.node_id) || {}),
    }));
    const relayEntries = await Promise.all(
      nodes
        .filter((item) => item.node_id !== localNode.node_id)
        .map(async (item) => [item.node_id, await safeLoad(`relay/${item.node_id}.json`)]),
    );
    const relays = Object.fromEntries(relayEntries);
    const origins = inventory.origins || {};

    target.replaceChildren();
    nodes.forEach((item) => {
      const origin = origins[item.node_id] || {};
      const document = item.node_id === localNode.node_id ? feed : (relays[item.node_id] || {});
      const messageCount = Number(document.message_count ?? document.messages?.length ?? 0);
      const sequence = origin.available_through_sequence;
      const hasSequence = sequence !== null && sequence !== undefined;
      const gaps = Array.isArray(origin.gaps) ? origin.gaps.length : 0;
      const state = item.node_id === localNode.node_id
        ? (status.result || "referencia")
        : (hasSequence ? "inventariado" : "sin datos");

      const card = element("article", `index-network-card index-network-${item.node_id.toLowerCase()}`);
      const head = element("div", "index-network-card-head");
      head.append(element("span", "index-network-id", item.node_id), element("span", "index-network-state", state));
      const metrics = element("div", "index-network-metrics");
      metrics.append(
        element("span", "index-network-metric", `${messageCount} mensaje(s)`),
        element("span", "index-network-metric", hasSequence ? `hasta sec. ${sequence}` : "sin secuencias"),
        element("span", "index-network-metric", gaps ? `${gaps} brecha(s)` : "sin brechas"),
      );
      card.append(
        head,
        element("strong", "", item.name || item.display_name || `Nodo ${item.node_id}`),
        element("small", "", `${item.city || "Ubicación pendiente"} · ${item.platform || "plataforma pendiente"}`),
        metrics,
      );
      target.append(card);
    });
    caption.textContent = `${network.network_name || "Sonantia Network"} · ${nodes.length} nodos definidos`;
  }).catch((error) => {
    console.error("No fue posible cargar el panorama Sonantia", error);
    target.replaceChildren(element("p", "index-network-empty", "El panorama distribuido no está disponible durante esta carga."));
  });
})();
</script>
{% endblock %}
