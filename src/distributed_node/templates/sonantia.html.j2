  function ensureTerminalPunctuation(value) {
    const cleaned = String(value || "").trim();
    if (!cleaned) return "";
    return /[.!?]$/u.test(cleaned) ? cleaned : `${cleaned}.`;
  }

  function displayMessageText(message, city) {
    const seed = text(message?.message_id, `${message?.created_at || ""}:${message?.sequence || ""}`);
    const greeting = localGreeting(message?.created_at, city, seed, message?.context?.weather);
    const climate = weatherSentence(message?.context?.weather, city, seed, message?.created_at);
    const affirmation = affirmationFromMessage(message);
    if (affirmation) {
      const reflection = `${reflectionLead(message, seed)} ${ensureTerminalPunctuation(affirmation)}`;
      return [greeting, climate, reflection].filter(Boolean).join(" ");
    }
    const original = messageSentences(message?.text).filter((sentence) => !isContextSentence(sentence)).join(" ");
    const fallback = original || "La publicación continúa activa y conserva el contexto disponible.";
    return [greeting, climate, ensureTerminalPunctuation(fallback)].filter(Boolean).join(" ");
  }

  function jsonDetailCard(title, value) {
    const card = element("section", "sonantia-message-detail-card");
    card.append(element("h3", "", title), element("pre", "", value ? JSON.stringify(value, null, 2) : "No disponible"));
    return card;
  }

  function technicalDetailCard(message) {
    const card = element("section", "sonantia-message-detail-card");
    card.append(element("h3", "", "Identidad y trazabilidad"));
    appendDefinitionList(card, [
      ["ID del mensaje", message.message_id],
      ["Secuencia", message.sequence],
      ["Hash SHA-256", message.content_hash],
      ["Protocolo", message.protocol_version],
      ["Época de red", message.network_epoch],
      ["Visibilidad", message.visibility],
      ["Idioma", message.language],
      ["Recibido desde", message.received_from_node_id],
      ["Recibido", message.received_at ? formatDate(message.received_at) : null],
      ["Saltos", message.hop_count],
    ], "sonantia-technical-dl");
    return card;
  }

  function messageCard(message, sourceNodeId = null) {
    const origin = text(message.origin_node_id || sourceNodeId, localNode.node_id);
    const meta = nodeMeta[origin] || {city: origin, platform: "Plataforma no informada"};
    const card = element("article", `sonantia-message ${nodeClass(origin)}`);
    const head = element("div", "sonantia-message-head");
    const originWrap = element("div", "sonantia-message-origin-wrap");
    originWrap.append(
      element("span", "sonantia-message-origin", `${origin} · ${meta.city}`),
      element("span", "sonantia-message-route", `${meta.platform}${message.received_from_node_id ? ` · recibido desde ${message.received_from_node_id}` : " · publicación de origen"}`)
    );
    const time = element("time", "", formatDate(message.created_at));
    if (message.created_at) time.dateTime = message.created_at;
    head.append(originWrap, time);
    card.append(
      head,
      element("p", "sonantia-message-text", displayMessageText(message, meta.city || origin)),
      renderContextSummary(message.context || {}, message, origin === localNode.node_id)
    );

    const details = element("details", "sonantia-message-details");
    details.append(element("summary", "", "Contexto completo y trazabilidad técnica"));
    const grid = element("div", "sonantia-message-detail-grid");
    grid.append(
      technicalDetailCard(message),
      jsonDetailCard("Generador del mensaje", message.generator),
      jsonDetailCard("Contexto factual completo", message.context),
      jsonDetailCard("Documento canónico", message)
    );
    details.append(grid);
    card.append(details);
    return card;
  }

  function renderMessageList(container, messages, emptyText, sourceNodeId = null) {
    container.replaceChildren();
    const ordered = [...(messages || [])].sort((a, b) => String(b.created_at || "").localeCompare(String(a.created_at || "")));
    if (!ordered.length) {
      container.append(element("p", "sonantia-empty", emptyText));
      return;
    }
    ordered.forEach((message) => container.append(messageCard(message, sourceNodeId)));
  }

  function networkNodes(network) {
    const configured = Array.isArray(network?.nodes) && network.nodes.length ? network.nodes : fallbackNodes;
    return fallbackNodes.map((fallback) => ({...fallback, ...(configured.find((item) => item.node_id === fallback.node_id) || {})}));
  }

  function renderNetworkOverview(network, inventory, relays, feed, status) {
    const target = byId("network-nodes");
    target.replaceChildren();
    const origins = inventory?.origins || {};
    const nodes = networkNodes(network);
    nodes.forEach((item) => {
      const nodeId = text(item.node_id, localNode.node_id);
      const fallback = nodeMeta[nodeId] || {};
      const originInventory = origins[nodeId] || {};
      const relay = nodeId === localNode.node_id ? feed : relays[nodeId];
      const messages = number(relay?.message_count || relay?.messages?.length);
      const available = originInventory.available_through_sequence !== null && originInventory.available_through_sequence !== undefined;
      const card = element("article", `sonantia-node-card ${nodeClass(nodeId)}`);
      const head = element("div", "sonantia-node-card-head");
      head.append(element("span", "sonantia-node-id", nodeId), element("span", "sonantia-node-state", nodeId === localNode.node_id ? text(status?.result, "referencia") : (available ? "inventariado" : "sin datos")));
      const metrics = element("div", "sonantia-node-metrics");
      metrics.append(
        element("span", "sonantia-node-metric", `${messages} mensaje(s)`),
        element("span", "sonantia-node-metric", available ? `hasta sec. ${text(originInventory.available_through_sequence)}` : "sin secuencias"),
        element("span", "sonantia-node-metric", Array.isArray(originInventory.gaps) && originInventory.gaps.length ? `${originInventory.gaps.length} brecha(s)` : "sin brechas")
      );
      card.append(
        head,
        element("strong", "", text(item.name || item.display_name, `Nodo ${fallback.city || nodeId}`)),
        element("small", "", `${text(item.city || item.location || fallback.city, fallback.city || "Ubicación pendiente")} · ${text(item.platform, fallback.platform || "Plataforma pendiente")}`),
        metrics
      );
      target.append(card);
    });
    byId("network-caption").textContent = `${text(network?.network_name, "Sonantia Network")} · ${nodes.length} nodos definidos`;
  }

  function renderOwnFeed(feed) {
    const messages = Array.isArray(feed?.messages) ? feed.messages : [];
    byId("own-caption").textContent = `${messages.length} mensaje(s) · actualizado ${formatDate(feed?.generated_at, true)}`;
    renderMessageList(byId("own-messages"), messages, `${localNode.node_id} todavía no ha publicado mensajes Sonantia.`, localNode.node_id);
  }

  function renderRelays(relays, network) {
    const target = byId("relay-groups");
    target.replaceChildren();
    let total = 0;
    relayNodeIds.forEach((nodeId) => {
      const result = relays[nodeId] || {ok: false, data: null};
      const relay = result.data || {};
      const messages = Array.isArray(relay.messages) ? relay.messages : [];
      total += messages.length;
      const configured = networkNodes(network).find((item) => item.node_id === nodeId) || {};
      const fallback = nodeMeta[nodeId] || {};
      const details = element("details", `sonantia-relay ${nodeClass(nodeId)}`);
      if (messages.length) details.open = true;
      const summary = element("summary", "");
      const copy = element("span", "sonantia-relay-copy");
      copy.append(
        element("strong", "", `${nodeId} · ${text(configured.city || configured.location, fallback.city || nodeId)}`),
        element("small", "", `${text(configured.platform, fallback.platform || "Plataforma pendiente")} · ${result.ok ? "relay consultado" : "recurso no disponible"}`)
      );
      summary.append(copy, element("span", "sonantia-relay-count", `${messages.length} mensaje(s)`));
      const body = element("div", "sonantia-relay-body");
      if (!result.ok) body.append(element("p", "sonantia-empty", `Este relay no pudo ser leído. ${localNode.node_id} continúa funcionando de manera independiente.`));
      else renderMessageList(body, messages, `${nodeId} todavía no aporta mensajes a la red.`, nodeId);
      details.append(summary, body);
      target.append(details);
    });
    byId("relay-caption").textContent = `${total} mensaje(s) remotos en ${relayNodeIds.length} relays`;
  }

  function renderStatus(network, sonantiaStatus) {
    const target = byId("status-panel");
    target.replaceChildren();
    appendDefinitionList(target, [
      ["Red", network?.network_name],
      ["Protocolo", `${text(network?.protocol_name, "Red Sonantia Network")} ${text(network?.protocol_version, "1.0")}`],
      ["Época", network?.network_epoch],
      ["Nodo de referencia", `${text(network?.reference_node_id, localNode.node_id)} · ${text(network?.reference_node_name, localNode.name)}`],
      ["Implementación", sonantiaStatus?.implementation_state || network?.implementation_state],
      ["Resultado", sonantiaStatus?.result],
      ["Estado operativo", sonantiaStatus?.result],
      ["Última ejecución", sonantiaStatus?.generated_at ? formatDate(sonantiaStatus.generated_at) : null],
      ["Feed", sonantiaStatus?.feed_message_count !== undefined ? `${sonantiaStatus.feed_message_count} mensajes` : null],
      ["Archivo", sonantiaStatus?.archive_message_count !== undefined ? `${sonantiaStatus.archive_message_count} mensajes` : null],
      ["Recursos", sonantiaStatus?.publication_file_count !== undefined ? `${sonantiaStatus.publication_file_count} archivos` : null],
    ]);
  }

  function renderInventory(inventory) {
    const target = byId("inventory-panel");
    target.replaceChildren();
    const entries = Object.entries(inventory?.origins || {});
    byId("inventory-count").textContent = String(entries.length);
    if (!entries.length) {
      target.append(element("p", "sonantia-empty", "No hay inventario disponible."));
      return;
    }
    const list = element("div", "sonantia-inventory-list");
    entries.forEach(([nodeId, item]) => {
      const row = element("article", `sonantia-inventory-row ${nodeClass(nodeId)}`);
      const head = element("div", "sonantia-inventory-head");
      head.append(element("strong", "", `${nodeId} · ${nodeMeta[nodeId]?.city || nodeId}`), element("span", "", text(item.role, "origen")));
      const metrics = element("div", "sonantia-inventory-metrics");
      metrics.append(
        element("span", "", `Desde ${text(item.available_from_sequence)}`),
        element("span", "", `Hasta ${text(item.available_through_sequence)}`),
        element("span", "", Array.isArray(item.gaps) && item.gaps.length ? `Brechas ${item.gaps.join(", ")}` : "Sin brechas"),
        element("span", "", `Archivo ${text(item.archive_through)}`)
      );
      row.append(head, metrics);
      list.append(row);
    });
    target.append(list);
  }

  function renderEvents(interactions) {
    const target = byId("events-panel");
    target.replaceChildren();
    const events = Array.isArray(interactions?.events) ? interactions.events : [];
    byId("events-count").textContent = String(number(interactions?.event_count || events.length));
    if (!events.length) {
      target.append(element("p", "sonantia-empty", "No hay interacciones registradas."));
      return;
    }
    const list = element("div", "sonantia-event-list");
    events.slice(0, 20).forEach((event) => {
      const row = element("article", "sonantia-event");
      row.append(
        element("strong", "", `${text(event.event_type, "evento")} · ${text(event.result, "sin resultado")}`),
        element("small", "", formatDate(event.occurred_at)),
        element("small", "", event.peer_node_id ? `Nodo relacionado: ${event.peer_node_id}` : "Evento local")
      );
      if (event.message_id || event.detail || event.error) {
        const details = element("details", "sonantia-node-details");
        details.append(element("summary", "", "Ver referencia técnica"));
        const body = element("div", "sonantia-node-details-body");
        appendDefinitionList(body, [["ID del mensaje", event.message_id], ["Detalle", event.detail], ["Error", event.error]], "sonantia-technical-dl");
        details.append(body);
        row.append(details);
      }
      list.append(row);
    });
    target.append(list);
  }

  async function renderArchive(index) {
    const target = byId("archive-panel");
    target.replaceChildren();
    const months = Array.isArray(index?.months) ? index.months : [];
    byId("archive-count").textContent = String(number(index?.message_count));
    appendDefinitionList(target, [
      ["Mensajes", index?.message_count],
      ["Primera secuencia", index?.first_sequence],
      ["Última secuencia", index?.last_sequence],
      ["Períodos", months.length],
      ["Actualizado", index?.generated_at ? formatDate(index.generated_at) : null],
    ]);
    if (!months.length) {
      target.append(element("p", "sonantia-empty", "El archivo histórico todavía está vacío."));
      return;
    }
    const list = element("div", "sonantia-archive-list");
    months.slice().reverse().forEach((month) => {
      const details = element("details", "sonantia-node-details");
      details.append(element("summary", "", `${text(month.period)} · ${number(month.message_count)} mensaje(s)`));
      const body = element("div", "sonantia-node-details-body sonantia-archive-list");
      body.append(element("p", "sonantia-loading", "Expanda para cargar los días del período."));
      details.addEventListener("toggle", async () => {
        if (!details.open || details.dataset.loaded === "true") return;
        details.dataset.loaded = "true";
        const origin = text(index.origin_node_id, localNode.node_id);
        const monthPath = `./archive/${origin}/${month.path}`;
        const monthResult = await loadJson(monthPath);
        const monthDocument = monthResult.data;
        body.replaceChildren();
        const days = Array.isArray(monthDocument?.days) ? monthDocument.days : [];
        if (!days.length) {
          body.append(element("p", "sonantia-empty", "No hay días disponibles en este período."));
          return;
        }
        days.slice().reverse().forEach((day) => {
          const dayDetails = element("details", "sonantia-node-details");
          dayDetails.append(element("summary", "", `${text(day.date)} · ${number(day.message_count)} mensaje(s)`));
          const dayBody = element("div", "sonantia-node-details-body sonantia-message-list");
          dayBody.append(element("p", "sonantia-loading", "Cargando mensajes…"));
          dayDetails.addEventListener("toggle", async () => {
            if (!dayDetails.open || dayDetails.dataset.loaded === "true") return;
            dayDetails.dataset.loaded = "true";
            const prefix = monthPath.slice(0, monthPath.lastIndexOf("/") + 1);
            const dayResult = await loadJson(prefix + day.path);
            renderMessageList(dayBody, Array.isArray(dayResult.data?.messages) ? dayResult.data.messages : [], "No hay mensajes en este día.", origin);
          });
          dayDetails.append(dayBody);
          body.append(dayDetails);
        });
      });
      details.append(body);
      list.append(details);
    });
    target.append(list);
  }

  function renderSummary(feed, relays, inventory, interactions, archive, network, status) {
    const ownCount = number(feed?.message_count || feed?.messages?.length);
    const relayCount = relayNodeIds.reduce((sum, nodeId) => sum + number(relays[nodeId]?.data?.message_count || relays[nodeId]?.data?.messages?.length), 0);
    const origins = Object.values(inventory?.origins || {});
    const activeOrigins = origins.filter((item) => item && item.available_through_sequence !== null && item.available_through_sequence !== undefined).length;
    const totalNodes = networkNodes(network).length;
    const result = text(status?.result || status?.implementation_state || network?.implementation_state, "Sin datos");
    const tone = statusTone(result);
    const statusCard = byId("kpi-status-card");
    statusCard.className = `sonantia-kpi sonantia-kpi-${tone}`;
    byId("kpi-status").textContent = result;
    byId("kpi-status-detail").textContent = "Superficie nativa Sonantia 1.0";
    byId("kpi-own").textContent = String(ownCount);
    byId("kpi-relay").textContent = String(relayCount);
    byId("kpi-origins").textContent = `${activeOrigins}/${totalNodes}`;
    byId("kpi-archive").textContent = String(number(archive?.message_count));
    byId("kpi-events").textContent = String(number(interactions?.event_count || interactions?.events?.length));
    byId("kpi-files").textContent = String(number(status?.publication_file_count));

    const timestamps = [feed?.generated_at, inventory?.generated_at, interactions?.generated_at, archive?.generated_at, network?.generated_at, status?.generated_at]
      .filter(Boolean).map((value) => new Date(value)).filter((date) => !Number.isNaN(date.getTime()));
    const latest = timestamps.length ? new Date(Math.max(...timestamps.map((date) => date.getTime()))) : null;
    byId("kpi-updated").textContent = latest ? formatDate(latest.toISOString(), true) : "—";
  }

  async function initialize() {
    const baseResults = await Promise.all([
      loadJson("./feed.json"),
      loadJson("./inventory.json"),
      loadJson("./network.json"),
      loadJson("./sonantia-status.json"),
      loadJson("./interactions/current.json"),
      loadJson("./archive/index.json"),
      ...relayNodeIds.map((nodeId) => loadJson(`./relay/${nodeId}.json`)),
    ]);
    const [feedResult, inventoryResult, networkResult, sonantiaStatusResult, interactionsResult, archiveResult, ...relayResults] = baseResults;
    const feed = feedResult.data || {messages: [], message_count: 0};
    const inventory = inventoryResult.data || {origins: {}};
    const network = networkResult.data || {network_name: "Sonantia Network", protocol_name: "Red Sonantia Network", protocol_version: "1.0", nodes: fallbackNodes};
    const sonantiaStatus = sonantiaStatusResult.data || {};
    const interactions = interactionsResult.data || {events: [], event_count: 0};
    const archive = archiveResult.data || {months: [], message_count: 0};
    const relays = Object.fromEntries(relayNodeIds.map((nodeId, index) => [nodeId, relayResults[index]]));

    renderOwnFeed(feed);
    renderRelays(relays, network);
    renderNetworkOverview(network, inventory, Object.fromEntries(relayNodeIds.map((nodeId) => [nodeId, relays[nodeId]?.data])), feed, sonantiaStatus);
    renderStatus(network, sonantiaStatus);
    renderInventory(inventory);
    renderEvents(interactions);
    await renderArchive(archive);
    renderSummary(feed, relays, inventory, interactions, archive, network, sonantiaStatus);

    const failed = baseResults.filter((result) => !result.ok).length;
    if (failed) console.warn(`Sonantia: vista parcial; ${failed} recurso(s) no disponibles`);
  }

  initialize().catch((error) => {
    console.error("Sonantia: error no controlado", error);
    document.querySelectorAll(".sonantia-loading").forEach((item) => {
      item.classList.remove("sonantia-loading");
      item.classList.add("sonantia-error");
      item.textContent = "No fue posible cargar esta sección.";
    });
  });
})();
</script>
{% endblock %}
