{% extends "base.html.j2" %}
{% block title %}{{ node.display_name }} · Sonantia{% endblock %}
{% block header_extra %}
<div class="current-time">
  <strong>Última Ejecución</strong>
  <time datetime="{{ updated_at|local_iso(node.logical_location.timezone) }}">{{ updated_at|local_datetime_short(node.logical_location.timezone) }}</time>
</div>
{% endblock %}
{% block content %}
<style>
  .sonantia-shell {
    --sonantia-panel:rgba(10, 17, 29, .94);
    --sonantia-panel-soft:rgba(17, 27, 43, .78);
    --sonantia-n01:#4ad4c6;
    --sonantia-n01-rgb:74, 212, 198;
    --sonantia-n02:#63b3ff;
    --sonantia-n02-rgb:99, 179, 255;
    --sonantia-n03:#c69cff;
    --sonantia-n03-rgb:198, 156, 255;
    --sonantia-n04:#ffb86c;
    --sonantia-n04-rgb:255, 184, 108;
    display:grid;
    gap:1rem;
  }
  .sonantia-summary {
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:.52rem;
  }
  .sonantia-kpi {
    position:relative;
    min-width:0;
    overflow:hidden;
    padding:.78rem .82rem;
    border:1px solid rgba(99, 179, 255, .14);
    border-radius:.68rem;
    background:linear-gradient(145deg, rgba(15, 24, 39, .88), rgba(7, 12, 21, .74));
  }
  .sonantia-kpi::before {
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    width:.18rem;
    background:#63b3ff;
    opacity:.8;
  }
  .sonantia-kpi-success::before { background:var(--green); }
  .sonantia-kpi-warning::before { background:var(--yellow); }
  .sonantia-kpi-danger::before { background:var(--red); }
  .sonantia-kpi span { display:block; margin-bottom:.32rem; color:var(--muted); font-size:.65rem; font-weight:800; letter-spacing:.055em; text-transform:uppercase; }
  .sonantia-kpi strong { display:block; overflow:hidden; color:#eaf4ff; font-size:1.22rem; line-height:1.15; text-overflow:ellipsis; white-space:nowrap; }
  .sonantia-kpi small { display:block; margin-top:.26rem; color:#8fa4bb; font-size:.65rem; line-height:1.35; }
  .sonantia-network-overview {
    display:grid;
    gap:.72rem;
    padding:.92rem;
    border:1px solid rgba(99, 179, 255, .16);
    border-radius:.76rem;
    background:rgba(7, 12, 21, .5);
  }
  .sonantia-section-head {
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:1rem;
    margin-bottom:.7rem;
  }
  .sonantia-section-head h2 { margin:0; font-size:1.18rem; }
  .sonantia-section-head p { margin:0; color:var(--muted); font-size:.75rem; }
  .sonantia-node-grid {
    display:grid;
    grid-template-columns:1fr;
    gap:.5rem;
  }
  .sonantia-node-card {
    --node-color:var(--sonantia-n02);
    --node-rgb:var(--sonantia-n02-rgb);
    position:relative;
    display:grid;
    gap:.35rem;
    min-width:0;
    padding:.72rem;
    border:1px solid rgba(var(--node-rgb), .25);
    border-radius:.65rem;
    background:
      radial-gradient(circle at 100% 0%, rgba(var(--node-rgb), .13), transparent 55%),
      rgba(8, 14, 24, .76);
  }
  .sonantia-node-n02 { --node-color:var(--sonantia-n02); --node-rgb:var(--sonantia-n02-rgb); }
  .sonantia-node-n03 { --node-color:var(--sonantia-n03); --node-rgb:var(--sonantia-n03-rgb); }
  .sonantia-node-n04 { --node-color:var(--sonantia-n04); --node-rgb:var(--sonantia-n04-rgb); }
  .sonantia-node-card-head { display:flex; justify-content:space-between; gap:.55rem; align-items:flex-start; }
  .sonantia-node-id { display:inline-flex; align-items:center; gap:.38rem; color:var(--node-color); font-size:.72rem; font-weight:900; letter-spacing:.055em; }
  .sonantia-node-id::before { content:""; width:.48rem; height:.48rem; flex:0 0 .48rem; border-radius:50%; background:var(--node-color); box-shadow:0 0 .55rem rgba(var(--node-rgb), .55); }
  .sonantia-node-state { padding:.12rem .34rem; border-radius:999px; color:var(--node-color); background:rgba(var(--node-rgb), .1); font-size:.56rem; font-weight:800; text-transform:uppercase; white-space:nowrap; }
  .sonantia-node-card strong { overflow:hidden; color:#e6f1fc; font-size:.82rem; text-overflow:ellipsis; white-space:nowrap; }
  .sonantia-node-card small { color:var(--muted); font-size:.63rem; line-height:1.35; }
  .sonantia-node-metrics { display:flex; flex-wrap:wrap; gap:.28rem; margin-top:.05rem; }
  .sonantia-node-metric { padding:.14rem .34rem; border:1px solid rgba(var(--node-rgb), .16); border-radius:999px; color:#bdd0e2; background:rgba(var(--node-rgb), .055); font-size:.56rem; white-space:nowrap; }
  .sonantia-layout { display:grid; grid-template-columns:minmax(0, 1fr) minmax(21rem, 27rem); gap:1rem; align-items:start; }
  .sonantia-main, .sonantia-rail { display:grid; gap:1rem; min-width:0; }
  .sonantia-rail { position:static; }
  .sonantia-network-state-body { gap:.78rem; }
  .sonantia-network-state .sonantia-summary { margin-top:.55rem; }
  .sonantia-status-detail {
    padding-top:.08rem;
    border-top:1px solid rgba(99, 179, 255, .1);
  }
  .sonantia-message-list { display:grid; gap:.62rem; }
  .sonantia-message {
    --node-color:var(--sonantia-n02);
    --node-rgb:var(--sonantia-n02-rgb);
    position:relative;
    display:grid;
    gap:.6rem;
    min-width:0;
    padding:.84rem .88rem;
    border:1px solid rgba(var(--node-rgb), .19);
    border-radius:.72rem;
    background:
      linear-gradient(90deg, rgba(var(--node-rgb), .13), transparent .28rem),
      linear-gradient(140deg, rgba(17, 27, 43, .94), rgba(8, 14, 24, .94));
    transition:border-color .16s ease, transform .16s ease;
  }
  .sonantia-message:hover { transform:translateY(-1px); border-color:rgba(var(--node-rgb), .36); }
  .sonantia-message.sonantia-node-n02 { --node-color:var(--sonantia-n02); --node-rgb:var(--sonantia-n02-rgb); }
  .sonantia-message.sonantia-node-n03 { --node-color:var(--sonantia-n03); --node-rgb:var(--sonantia-n03-rgb); }
  .sonantia-message.sonantia-node-n04 { --node-color:var(--sonantia-n04); --node-rgb:var(--sonantia-n04-rgb); }
  .sonantia-message-head { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }
  .sonantia-message-origin-wrap { display:grid; gap:.14rem; min-width:0; }
  .sonantia-message-origin { display:inline-flex; align-items:center; gap:.4rem; color:var(--node-color); font-size:.72rem; font-weight:900; letter-spacing:.045em; }
  .sonantia-message-origin::before { content:""; width:.47rem; height:.47rem; flex:0 0 .47rem; border-radius:50%; background:var(--node-color); box-shadow:0 0 .55rem rgba(var(--node-rgb), .48); }
  .sonantia-message-route { color:#8fa4ba; font-size:.61rem; }
  .sonantia-message time { color:var(--muted); font-size:.68rem; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .sonantia-message-text { margin:0; color:#edf6ff; font-size:.9rem; line-height:1.58; }
  .sonantia-context-summary {
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "weather astronomy"
      "geology economy";
    gap:.42rem;
  }
  .sonantia-context-card {
    --context-color:#63b3ff;
    min-width:0;
    padding:.52rem .56rem;
    border:1px solid color-mix(in srgb, var(--context-color) 22%, transparent);
    border-radius:.55rem;
    background:color-mix(in srgb, var(--context-color) 7%, rgba(5, 10, 18, .62));
  }
  .sonantia-context-weather { --context-color:#4ad4c6; grid-area:weather; }
  .sonantia-context-geology { --context-color:#ffb86c; grid-area:geology; }
  .sonantia-context-astronomy { --context-color:#c69cff; grid-area:astronomy; }
  .sonantia-context-economy { --context-color:#63b3ff; grid-area:economy; }
  .sonantia-context-card-head { display:flex; justify-content:space-between; gap:.45rem; align-items:center; margin-bottom:.28rem; }
  .sonantia-context-card-head strong { color:var(--context-color); font-size:.65rem; letter-spacing:.04em; text-transform:uppercase; }
  .sonantia-context-card-head span { color:var(--muted); font-size:.55rem; }
  .sonantia-context-primary { margin:0; color:#e4eef8; font-size:.72rem; font-weight:750; line-height:1.35; }
  .sonantia-context-secondary { margin:.18rem 0 0; color:#94a9be; font-size:.61rem; line-height:1.38; }
  .sonantia-context-method {
    margin:.34rem 0 0;
    padding-top:.32rem;
    border-top:1px solid color-mix(in srgb, var(--context-color) 16%, transparent);
    color:#8198af;
    font-size:.56rem;
    line-height:1.4;
  }
  .sonantia-astro-list {
    display:flex;
    flex-wrap:wrap;
    gap:.38rem;
    margin-top:.08rem;
  }
  .sonantia-astro-item {
    display:grid;
    flex:1 1 8.8rem;
    gap:.42rem;
    align-content:start;
    min-width:0;
    padding:.5rem;
    border:1px solid color-mix(in srgb, var(--context-color) 18%, transparent);
    border-radius:.5rem;
    background:linear-gradient(145deg, rgba(22, 17, 39, .66), rgba(5, 10, 18, .36));
  }
  .sonantia-astro-head {
    display:grid;
    grid-template-columns:1.9rem minmax(0, 1fr);
    gap:.4rem;
    align-items:center;
    min-width:0;
  }
  .sonantia-astro-icon {
    display:grid;
    place-items:center;
    width:1.9rem;
    height:1.9rem;
    border:1px solid color-mix(in srgb, var(--context-color) 24%, transparent);
    border-radius:50%;
    color:#f0e4ff;
    background:color-mix(in srgb, var(--context-color) 10%, rgba(5, 10, 18, .7));
    font-size:1.04rem;
    line-height:1;
  }
  .sonantia-astro-copy { display:grid; gap:.04rem; min-width:0; }
  .sonantia-astro-copy strong { color:#eee5fb; font-size:.64rem; line-height:1.25; }
  .sonantia-astro-copy small { color:#a89ab9; font-size:.53rem; line-height:1.3; text-transform:capitalize; }
  .sonantia-astro-metrics { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:.22rem; }
  .sonantia-astro-metric {
    display:grid;
    gap:.04rem;
    min-width:0;
    padding:.25rem .29rem;
    border-radius:.34rem;
    background:rgba(198, 156, 255, .055);
  }
  .sonantia-astro-metric span { color:#8f82a2; font-size:.46rem; font-weight:800; letter-spacing:.035em; text-transform:uppercase; }
  .sonantia-astro-metric strong { color:#ded4ed; font-size:.57rem; font-variant-numeric:tabular-nums; }
  .sonantia-astro-visibility {
    display:flex;
    align-items:center;
    gap:.24rem;
    margin:0;
    color:#a99bb9;
    font-size:.53rem;
    line-height:1.3;
  }
  .sonantia-astro-visibility::before { content:"✦"; color:var(--context-color); font-size:.46rem; }
  .sonantia-context-unavailable { grid-column:1 / -1; padding:.42rem .55rem; border:1px dashed rgba(158, 172, 192, .2); border-radius:.5rem; color:var(--muted); font-size:.65rem; text-align:center; }
  .sonantia-message-details { padding-top:.45rem; border-top:1px solid rgba(var(--node-rgb), .13); }
  .sonantia-message-details > summary { cursor:pointer; color:var(--node-color); font-size:.68rem; font-weight:800; list-style:none; }
  .sonantia-message-details > summary::-webkit-details-marker { display:none; }
  .sonantia-message-details > summary::before { content:"＋"; display:inline-grid; place-items:center; width:1.1rem; height:1.1rem; margin-right:.32rem; border-radius:50%; color:var(--node-color); background:rgba(var(--node-rgb), .09); }
  .sonantia-message-details[open] > summary::before { content:"−"; }
  .sonantia-message-detail-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:.48rem; margin-top:.58rem; }
  .sonantia-message-detail-card { min-width:0; padding:.54rem; border:1px solid rgba(99, 179, 255, .12); border-radius:.54rem; background:rgba(5, 10, 18, .46); }
  .sonantia-message-detail-card h3 { margin:0 0 .4rem; color:#d6a95d; font-size:.68rem; }
  .sonantia-message-detail-card pre { max-height:15rem; margin:0; overflow:auto; color:#c8d8e8; font:.62rem/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; white-space:pre-wrap; word-break:break-word; }
  .sonantia-technical-dl { grid-template-columns:minmax(7rem, max-content) 1fr; gap:.28rem .55rem; margin:0; font-size:.64rem; }
  .sonantia-technical-dl dt { color:#8fa4ba; }
  .sonantia-technical-dl dd { margin:0; overflow-wrap:anywhere; color:#d7e5f2; }
  .sonantia-relay-list { display:grid; gap:.58rem; }
  .sonantia-relay {
    --node-color:var(--sonantia-n02);
    --node-rgb:var(--sonantia-n02-rgb);
    overflow:hidden;
    border:1px solid rgba(var(--node-rgb), .2);
    border-radius:.68rem;
    background:rgba(8, 14, 24, .68);
  }
  .sonantia-relay.sonantia-node-n03 { --node-color:var(--sonantia-n03); --node-rgb:var(--sonantia-n03-rgb); }
  .sonantia-relay.sonantia-node-n04 { --node-color:var(--sonantia-n04); --node-rgb:var(--sonantia-n04-rgb); }
  .sonantia-relay > summary { display:flex; align-items:center; gap:.7rem; padding:.72rem .78rem; cursor:pointer; list-style:none; }
  .sonantia-relay > summary::-webkit-details-marker { display:none; }
  .sonantia-relay > summary::after { content:"＋"; display:grid; place-items:center; width:1.35rem; height:1.35rem; flex:0 0 1.35rem; border-radius:50%; color:var(--node-color); background:rgba(var(--node-rgb), .1); }
  .sonantia-relay[open] > summary::after { content:"−"; }
  .sonantia-relay-copy { display:grid; gap:.08rem; min-width:0; margin-right:auto; }
  .sonantia-relay-copy strong { color:var(--node-color); font-size:.78rem; }
  .sonantia-relay-copy small { color:var(--muted); font-size:.61rem; }
  .sonantia-relay-count { padding:.14rem .4rem; border-radius:999px; color:var(--node-color); background:rgba(var(--node-rgb), .09); font-size:.58rem; font-weight:800; white-space:nowrap; }
  .sonantia-relay-body { padding:.2rem .72rem .72rem; border-top:1px solid rgba(var(--node-rgb), .14); }
  .sonantia-relay-body .sonantia-message-list { margin-top:.52rem; }
  .sonantia-panel {
    overflow:hidden;
    border:1px solid rgba(99, 179, 255, .14);
    border-radius:.7rem;
    background:var(--sonantia-panel);
  }
  .sonantia-panel > summary { display:flex; align-items:center; gap:.7rem; padding:.78rem .85rem; cursor:pointer; color:#e4f0fb; font-weight:800; list-style:none; }
  .sonantia-panel > summary::-webkit-details-marker { display:none; }
  .sonantia-panel > summary::after { content:"＋"; color:#63b3ff; font-size:1rem; }
  .sonantia-panel[open] > summary::after { content:"−"; }
  .sonantia-panel-title { display:grid; gap:.06rem; margin-right:auto; }
  .sonantia-panel-title strong { font-size:.76rem; }
  .sonantia-panel-title small { color:var(--muted); font-size:.58rem; font-weight:500; }
  .sonantia-panel-count { padding:.14rem .4rem; border-radius:999px; color:#a8f3e9; background:rgba(74, 212, 198, .1); font-size:.6rem; }
  .sonantia-panel-body { display:grid; gap:.65rem; padding:.12rem .85rem .85rem; border-top:1px solid rgba(99, 179, 255, .09); }
  .sonantia-dl { grid-template-columns:minmax(7.7rem, max-content) 1fr; gap:.3rem .65rem; margin:.55rem 0 0; font-size:.71rem; }
  .sonantia-dl dt { color:#8fa4ba; }
  .sonantia-dl dd { margin:0; overflow-wrap:anywhere; color:#d8e6f3; }
  .sonantia-inventory-list, .sonantia-event-list, .sonantia-archive-list { display:grid; gap:.48rem; margin-top:.55rem; }
  .sonantia-inventory-row, .sonantia-event, .sonantia-archive-row { display:grid; gap:.2rem; padding:.56rem; border:1px solid rgba(99, 179, 255, .09); border-radius:.52rem; background:rgba(5, 10, 18, .4); }
  .sonantia-inventory-head { display:flex; justify-content:space-between; gap:.55rem; align-items:center; }
  .sonantia-inventory-head strong, .sonantia-event strong, .sonantia-archive-row strong { color:#dbeaff; font-size:.73rem; }
  .sonantia-inventory-head span, .sonantia-event small, .sonantia-archive-row small { color:#8ea3ba; font-size:.62rem; }
  .sonantia-inventory-metrics { display:flex; flex-wrap:wrap; gap:.28rem; }
  .sonantia-inventory-metrics span { padding:.13rem .32rem; border-radius:999px; color:#a9bdd1; background:rgba(99, 179, 255, .055); font-size:.56rem; }
  .sonantia-node-details { border:1px solid rgba(99, 179, 255, .1); border-radius:.55rem; background:rgba(5, 10, 18, .34); }
  .sonantia-node-details > summary { padding:.62rem; cursor:pointer; color:#dce9f5; font-size:.7rem; font-weight:750; }
  .sonantia-node-details-body { padding:0 .62rem .62rem; }
  .sonantia-resource-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:.44rem; margin-top:.55rem; }
  .sonantia-resource-grid a { display:block; padding:.5rem; border:1px solid rgba(99, 179, 255, .12); border-radius:.5rem; background:rgba(99, 179, 255, .05); font-size:.7rem; overflow-wrap:anywhere; }
  .sonantia-empty { margin:0; padding:.78rem; border:1px dashed rgba(158, 172, 192, .22); border-radius:.6rem; color:#9eacc0; text-align:center; }
  .sonantia-loading { color:#9eacc0; }
  .sonantia-error { color:#ff9aa5; }
  @media (max-width: 1080px) {
    .sonantia-layout { grid-template-columns:1fr; }
    .sonantia-rail { grid-template-columns:repeat(2, minmax(0,1fr)); }
    .sonantia-network-state,
    .sonantia-network-overview { grid-column:1 / -1; }
    .sonantia-node-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .sonantia-summary { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .sonantia-message-detail-grid { grid-template-columns:1fr; }
  }
  @media (max-width: 580px) {
    .sonantia-summary, .sonantia-node-grid, .sonantia-rail, .sonantia-context-summary, .sonantia-resource-grid { grid-template-columns:1fr; }
    .sonantia-context-summary { grid-template-areas:"weather" "astronomy" "geology" "economy"; }
    .sonantia-section-head, .sonantia-message-head { align-items:flex-start; flex-direction:column; }
    .sonantia-message time { white-space:normal; }
    .sonantia-relay > summary { align-items:flex-start; }
  }
</style>

<div class="sonantia-shell">
  <div class="sonantia-layout">
    <div class="sonantia-main">
      <section aria-labelledby="own-title">
        <div class="sonantia-section-head">
          <div><p class="eyebrow">Publicación local</p><h2 id="own-title">Mensajes propios de {{ node.node_id }}</h2></div>
          <p id="own-caption">Cargando feed...</p>
        </div>
        <div id="own-messages" class="sonantia-message-list"><p class="sonantia-empty sonantia-loading">Cargando mensajes propios…</p></div>
      </section>

      <section aria-labelledby="relay-title">
        <div class="sonantia-section-head">
          <div><p class="eyebrow">Tráfico distribuido</p><h2 id="relay-title">Mensajes de otros nodos</h2></div>
          <p id="relay-caption">Cargando relays...</p>
        </div>
        <div id="relay-groups" class="sonantia-relay-list"><p class="sonantia-empty sonantia-loading">Cargando mensajes de la red…</p></div>
      </section>
    </div>

    <aside class="sonantia-rail" aria-label="Estado y recursos de Sonantia">
      <details class="sonantia-panel sonantia-network-state" open>
        <summary><span class="sonantia-panel-title"><strong>Estado de red</strong><small>Resumen, protocolo, integración y ciclo</small></span></summary>
        <div class="sonantia-panel-body sonantia-network-state-body">
          <section class="sonantia-summary" aria-label="Resumen visual de Sonantia">
            <article class="sonantia-kpi" id="kpi-status-card"><span>Estado actual</span><strong id="kpi-status">—</strong><small id="kpi-status-detail">Sin datos</small></article>
            <article class="sonantia-kpi"><span>Mensajes propios</span><strong id="kpi-own">0</strong><small>Ventana publicada por {{ node.node_id }}</small></article>
            <article class="sonantia-kpi"><span>Mensajes en tránsito</span><strong id="kpi-relay">0</strong><small>Custodiados desde otros nodos</small></article>
            <article class="sonantia-kpi"><span>Nodos con información</span><strong id="kpi-origins">0/4</strong><small>Orígenes disponibles en {{ node.node_id }}</small></article>
            <article class="sonantia-kpi"><span>Archivo histórico</span><strong id="kpi-archive">0</strong><small>Mensajes propios conservados</small></article>
            <article class="sonantia-kpi"><span>Interacciones</span><strong id="kpi-events">0</strong><small>Eventos operativos recientes</small></article>
            <article class="sonantia-kpi"><span>Recursos publicados</span><strong id="kpi-files">0</strong><small>Documentos públicos de Sonantia</small></article>
            <article class="sonantia-kpi"><span>Última actualización</span><strong id="kpi-updated">—</strong><small>Documento más reciente</small></article>
          </section>
          <div class="sonantia-status-detail" id="status-panel"><p class="sonantia-empty sonantia-loading">Cargando estado…</p></div>
        </div>
      </details>

      <section class="sonantia-network-overview" aria-labelledby="sonantia-network-title">
        <div class="sonantia-section-head">
          <div><p class="eyebrow">Panorama distribuido</p><h2 id="sonantia-network-title">Nodos de Sonantia</h2></div>
          <p id="network-caption">Cargando topología...</p>
        </div>
        <div id="network-nodes" class="sonantia-node-grid"><p class="sonantia-empty sonantia-loading">Cargando nodos…</p></div>
      </section>

      <details class="sonantia-panel" open>
        <summary><span class="sonantia-panel-title"><strong>Inventario por origen</strong><small>Disponibilidad y brechas</small></span><span class="sonantia-panel-count" id="inventory-count">0</span></summary>
        <div class="sonantia-panel-body" id="inventory-panel"><p class="sonantia-empty sonantia-loading">Cargando inventario…</p></div>
      </details>

      <details class="sonantia-panel" id="interacciones">
        <summary><span class="sonantia-panel-title"><strong>Interacciones recientes</strong><small>Recepción, validación y publicación</small></span><span class="sonantia-panel-count" id="events-count">0</span></summary>
        <div class="sonantia-panel-body" id="events-panel"><p class="sonantia-empty sonantia-loading">Cargando interacciones…</p></div>
