    const period = daypartPhrase(hour);
    if (Number.isFinite(temperature) && Number.isFinite(humidity)) {
      const t = formatNumber(temperature, 1);
      const h = formatNumber(humidity, 1);
      const description = weatherDescription(temperature, humidity);
      const general = [
        `El registro local marca ${t} °C y ${h} % de humedad relativa.`,
        `A esta hora, ${safeCity} registra ${t} °C, con una humedad relativa de ${h} %.`,
        `La medición ambiental informa ${t} °C y ${h} % de humedad relativa.`,
        `El ambiente se presenta ${description}, con ${t} °C y ${h} % de humedad.`,
        `La lectura consolidada sitúa la temperatura en ${t} °C y la humedad en ${h} %.`,
        `Las estaciones integradas registran ${t} °C y una humedad relativa de ${h} %.`,
        `La observación del momento indica ${t} °C y ${h} % de humedad relativa.`,
        `En el entorno de ${safeCity} se observan ${t} °C y ${h} % de humedad.`,
        `La temperatura local alcanza ${t} °C, mientras la humedad se sitúa en ${h} %.`,
        `El contexto meteorológico combina ${t} °C con una humedad relativa de ${h} %.`,
        `La lectura ambiental describe un entorno ${description}: ${t} °C y ${h} % de humedad.`,
        `El registro consolidado informa una temperatura de ${t} °C y una humedad de ${h} %.`,
        `Los datos disponibles describen ${t} °C y ${h} % de humedad relativa.`,
        `La lectura conjunta de las estaciones entrega ${t} °C y ${h} % de humedad.`,
        `El panorama local queda definido por ${t} °C y una humedad relativa de ${h} %.`,
        `La observación ambiental sitúa el entorno en ${t} °C y ${h} % de humedad.`,
        `El momento actual presenta ${t} °C, acompañado de una humedad de ${h} %.`,
        `La medición consolidada registra ${t} °C y mantiene la humedad en ${h} %.`,
        `Durante ${period}, la lectura local informa ${t} °C y ${h} % de humedad.`,
        `El ambiente de ${safeCity} se describe con ${t} °C y una humedad de ${h} %.`,
      ];
      const conditional = [];
      if (temperature < 8) {
        conditional.push(
          `El ambiente permanece frío, con ${t} °C y ${h} % de humedad relativa.`,
          `La lectura confirma condiciones frías: ${t} °C y una humedad de ${h} %.`
        );
      } else if (temperature < 14) {
        conditional.push(
          `El entorno se mantiene fresco, con ${t} °C y ${h} % de humedad.`,
          `La jornada presenta condiciones frescas: ${t} °C y ${h} % de humedad relativa.`
        );
      } else if (temperature < 23) {
        conditional.push(
          `El entorno se mantiene templado, con ${t} °C y ${h} % de humedad.`,
          `La lectura describe condiciones templadas: ${t} °C y ${h} % de humedad relativa.`
        );
      } else if (temperature < 29) {
        conditional.push(
          `El ambiente se presenta cálido, con ${t} °C y ${h} % de humedad.`,
          `La lectura refleja una jornada cálida: ${t} °C y ${h} % de humedad relativa.`
        );
      } else {
        conditional.push(
          `El ambiente registra temperaturas elevadas: ${t} °C y ${h} % de humedad.`,
          `La lectura confirma una jornada calurosa, con ${t} °C y ${h} % de humedad relativa.`
        );
      }
      if (humidity >= 80) {
        conditional.push(
          `La humedad es elevada y alcanza ${h} %, mientras la temperatura se sitúa en ${t} °C.`,
          `El entorno se presenta muy húmedo: ${h} % de humedad y ${t} °C.`
        );
      } else if (humidity < 35) {
        conditional.push(
          `El ambiente se mantiene seco, con ${h} % de humedad y una temperatura de ${t} °C.`,
          `La baja humedad marca la lectura: ${h} %, junto con ${t} °C.`
        );
      }
      return stableChoice([...general, ...conditional], seed, 11);
    }
    if (Number.isFinite(temperature)) {
      const t = formatNumber(temperature, 1);
      return stableChoice([
        `El registro local informa una temperatura de ${t} °C.`,
        `A esta hora, la temperatura en ${safeCity} alcanza ${t} °C.`,
        `La medición ambiental sitúa la temperatura en ${t} °C.`,
        `Las estaciones disponibles registran ${t} °C.`,
        `La lectura consolidada ubica la temperatura en ${t} °C.`,
        `El entorno local presenta una temperatura de ${t} °C.`,
        `Durante ${period}, el registro térmico alcanza ${t} °C.`,
        `La observación disponible informa ${t} °C.`,
      ], seed, 13);
    }
    if (Number.isFinite(humidity)) {
      const h = formatNumber(humidity, 1);
      return stableChoice([
        `El registro local informa una humedad relativa de ${h} %.`,
        `A esta hora, la humedad en ${safeCity} se sitúa en ${h} %.`,
        `La medición ambiental indica ${h} % de humedad relativa.`,
        `Las estaciones disponibles registran una humedad de ${h} %.`,
        `La lectura consolidada sitúa la humedad en ${h} %.`,
        `El entorno local presenta ${h} % de humedad relativa.`,
        `Durante ${period}, la humedad registrada alcanza ${h} %.`,
        `La observación disponible informa una humedad de ${h} %.`,
      ], seed, 17);
    }
    return "";
  }

