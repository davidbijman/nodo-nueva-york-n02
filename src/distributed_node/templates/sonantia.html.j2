      <details class="sonantia-panel" id="archivo">
        <summary><span class="sonantia-panel-title"><strong>Archivo histórico</strong><small>Períodos y mensajes conservados</small></span><span class="sonantia-panel-count" id="archive-count">0</span></summary>
        <div class="sonantia-panel-body" id="archive-panel"><p class="sonantia-empty sonantia-loading">Cargando archivo…</p></div>
      </details>

      <details class="sonantia-panel">
        <summary><span class="sonantia-panel-title"><strong>Recursos JSON</strong><small>Datos originales de la red</small></span></summary>
        <div class="sonantia-panel-body">
          <div class="sonantia-resource-grid">
            <a href="./feed.json">Feed propio</a>
            <a href="./inventory.json">Inventario</a>
            <a href="./network.json">Topología</a>
            <a href="./sonantia-status.json">Estado Sonantia</a>
            <a href="./interactions/current.json">Interacciones</a>
            <a href="./archive/index.json">Archivo</a>
            <a href="./node.json">Definición del nodo</a>
          </div>
        </div>
      </details>
    </aside>
  </div>
</div>
<noscript><p class="sonantia-empty">Esta vista necesita JavaScript para integrar los documentos JSON de Sonantia.</p></noscript>
{% endblock %}
{% block scripts %}
<script>
(() => {
  "use strict";

  const localNode = {
    node_id: {{ node.node_id|tojson }},
    name: {{ node.display_name|tojson }},
    city: {{ node.logical_location.city|tojson }},
    platform: {{ node.infrastructure.provider|tojson }},
    timezone: {{ node.logical_location.timezone|tojson }},
  };
  const fallbackNodes = [
    localNode,
    {% for card in peer_cards %}
    {
      node_id: {{ card.peer.node_id|tojson }},
      name: {{ card.peer.display_name|tojson }},
      city: {{ card.peer.display_name|replace("Nodo ", "")|tojson }},
      platform: null,
    },
    {% endfor %}
  ];
  const nodeMeta = Object.fromEntries(
    fallbackNodes.map((item) => [item.node_id, {city: item.city, platform: item.platform}]),
  );
  const relayNodeIds = fallbackNodes
    .map((item) => item.node_id)
    .filter((nodeId) => nodeId !== localNode.node_id);
  const currentAstronomySnapshot = {{ astronomy|default({})|tojson }};

  const byId = (id) => document.getElementById(id);
  const number = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
  const text = (value, fallback = "—") => value === null || value === undefined || value === "" ? fallback : String(value);
  const nodeClass = (nodeId) => `sonantia-node-${String(nodeId || localNode.node_id).toLowerCase()}`;
  const formatNumber = (value, digits = 2) => {
    const parsed = Number(value);
    if (!Number.isFinite(parsed)) return "—";
    return new Intl.NumberFormat("es-CL", {maximumFractionDigits: digits}).format(parsed);
  };
  const formatDate = (value, compact = false) => {
    if (!value) return "—";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return new Intl.DateTimeFormat("es-CL", compact ? {
      day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false, timeZone: localNode.timezone
    } : {
      day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: localNode.timezone
    }).format(date);
  };

  async function loadJson(path) {
    try {
      const response = await fetch(path, {cache: "no-store"});
      if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
      return {ok: true, data: await response.json(), path};
    } catch (error) {
      console.warn(`Sonantia: no fue posible cargar ${path}`, error);
      return {ok: false, data: null, path, error: String(error)};
    }
  }

  function element(tag, className, value) {
    const item = document.createElement(tag);
    if (className) item.className = className;
    if (value !== undefined && value !== null) item.textContent = String(value);
    return item;
  }

  function appendDefinitionList(container, entries, className = "sonantia-dl") {
    const list = element("dl", className);
    entries.filter(([, value]) => value !== null && value !== undefined && value !== "").forEach(([label, value]) => {
      list.append(element("dt", "", label), element("dd", "", text(value)));
    });
    container.append(list);
    return list;
  }

  function statusTone(value) {
    const normalized = String(value || "").toLowerCase();
    if (["success", "operational", "active", "reachable", "rendered", "ok"].some((item) => normalized.includes(item))) return "success";
    if (["degraded", "warning", "partial", "shadow"].some((item) => normalized.includes(item))) return "warning";
    if (["failed", "unavailable", "error", "unreachable"].some((item) => normalized.includes(item))) return "danger";
    return "neutral";
  }

  function contextCard(type, title, primary, secondary, state = "", extra = null) {
    const card = element("article", `sonantia-context-card sonantia-context-${type}`);
    const head = element("div", "sonantia-context-card-head");
    head.append(element("strong", "", title));
    const visibleState = String(state || "").trim();
    if (visibleState && !["available", "disponible"].includes(visibleState.toLowerCase())) {
      head.append(element("span", "", visibleState));
    }
    card.append(head);
    if (primary) card.append(element("p", "sonantia-context-primary", primary));
    if (secondary) card.append(element("p", "sonantia-context-secondary", secondary));
    if (extra) card.append(extra);
    return card;
  }


  function astronomyIcon(target) {
    if (target?.icon) return String(target.icon);
    const icons = {
      sol:"☀️", luna:"🌙", mercurio:"☿", venus:"♀", marte:"♂", ceres:"⚳",
      palas:"◆", pallas:"◆", vesta:"◇", eros:"◆", bennu:"◆", júpiter:"♃",
      jupiter:"♃", ío:"●", io:"●", europa:"●", ganímedes:"●", ganimedes:"●",
      calisto:"●", saturno:"♄", titán:"●", titan:"●", urano:"♅", neptuno:"♆",
      tritón:"●", triton:"●", plutón:"♇", pluton:"♇"
    };
    return icons[String(target?.name || "").toLocaleLowerCase("es-CL")] || "✦";
  }

  function astronomyPosition(target) {
    const elevation = target?.elevation_deg ?? target?.elevation;
    const azimuth = target?.azimuth_deg ?? target?.azimuth;
    return [
      elevation !== undefined && elevation !== null ? `Elevación ${formatNumber(elevation)}°` : null,
      azimuth !== undefined && azimuth !== null ? `Azimut ${formatNumber(azimuth)}°` : null,
      target?.visibility,
    ].filter(Boolean).join(" · ");
  }

  function stableSample(items, count, seedText) {
    const pool = [...items];
    let seed = 2166136261;
    for (const char of String(seedText || "Sonantia")) {
      seed ^= char.charCodeAt(0);
      seed = Math.imul(seed, 16777619) >>> 0;
    }
    for (let index = pool.length - 1; index > 0; index -= 1) {
      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
      const selected = seed % (index + 1);
      [pool[index], pool[selected]] = [pool[selected], pool[index]];
    }
    return pool.slice(0, count);
  }

  function availableAstronomyTargets(astronomy, message, allowCurrentSnapshot) {
    const candidates = [
      astronomy?.targets,
      astronomy?.available_targets,
      astronomy?.objects,
      allowCurrentSnapshot ? currentAstronomySnapshot?.targets : null,
    ];
    const source = candidates.find((value) => Array.isArray(value)) || [];
    const available = source.filter((target) => {
      if (!target || typeof target !== "object") return false;
      const status = String(target.status || "available").toLowerCase();
      return status === "available" && (target.name || astronomyPosition(target));
    });
    return stableSample(available, 3, message?.message_id || message?.created_at);
  }

  function astronomyList(targets) {
    const list = element("div", "sonantia-astro-list");
    targets.forEach((target) => {
      const item = element("article", "sonantia-astro-item");
      const head = element("div", "sonantia-astro-head");
      const copy = element("div", "sonantia-astro-copy");
      copy.append(
        element("strong", "", text(target.name, "Astro")),
        element("small", "", text(target.kind, "objeto astronómico"))
      );
      head.append(element("span", "sonantia-astro-icon", astronomyIcon(target)), copy);

      const elevation = target?.elevation_deg ?? target?.elevation;
      const azimuth = target?.azimuth_deg ?? target?.azimuth;
      const metrics = element("div", "sonantia-astro-metrics");
      const elevationMetric = element("div", "sonantia-astro-metric");
      elevationMetric.append(
        element("span", "", "Elevación"),
        element("strong", "", elevation !== undefined && elevation !== null ? `${formatNumber(elevation)}°` : "—")
      );
      const azimuthMetric = element("div", "sonantia-astro-metric");
      azimuthMetric.append(
        element("span", "", "Azimut"),
        element("strong", "", azimuth !== undefined && azimuth !== null ? `${formatNumber(azimuth)}°` : "—")
      );
      metrics.append(elevationMetric, azimuthMetric);

      const visibility = element("p", "sonantia-astro-visibility", text(target.visibility, "Visibilidad no informada"));
      item.append(head, metrics, visibility);
      list.append(item);
    });
    return list;
  }

  function renderContextSummary(context, message, allowCurrentAstronomy = false) {
    const wrapper = element("div", "sonantia-context-summary");
    const weather = context?.weather;
    const weatherData = weather?.data || {};
    if (weather && Object.keys(weatherData).length) {
      const main = [
        weatherData.temperature_c !== undefined && weatherData.temperature_c !== null ? `${formatNumber(weatherData.temperature_c, 1)} °C` : null,
        weatherData.relative_humidity_percent !== undefined && weatherData.relative_humidity_percent !== null ? `${formatNumber(weatherData.relative_humidity_percent, 1)} % HR` : null,
        weatherData.pressure_hpa !== undefined && weatherData.pressure_hpa !== null ? `${formatNumber(weatherData.pressure_hpa, 2)} hPa` : null,
      ].filter(Boolean).join(" · ");
      const secondary = [
        weatherData.precipitation_mm !== undefined && weatherData.precipitation_mm !== null ? `Lluvia acumulada ${formatNumber(weatherData.precipitation_mm, 2)} mm` : null,
        weatherData.solar_radiation_wm2 !== undefined && weatherData.solar_radiation_wm2 !== null ? `Radiación ${formatNumber(weatherData.solar_radiation_wm2, 2)} W/m²` : null,
        weather.observed_at ? `Observado ${formatDate(weather.observed_at, true)}` : null,
      ].filter(Boolean).join(" · ");
      wrapper.append(contextCard("weather", "Meteorología", main || "Datos disponibles", secondary, text(weather.status, "disponible")));
    }

    const geology = context?.geology;
    if (geology) {
      const event = geology.recent_event || {};
      const main = event.magnitude !== undefined
        ? `Último Sismo Informado · M ${formatNumber(event.magnitude, 1)} · ${text(event.location, "ubicación no informada")}`
        : `Último Sismo Informado · ${formatNumber(geology.count, 0)} eventos en la ventana`;
      const secondary = [
        event.depth_km !== undefined ? `Profundidad ${formatNumber(event.depth_km)} km` : null,
        event.local_time || event.occurred_at ? formatDate(event.local_time || event.occurred_at, true) : null,
      ].filter(Boolean).join(" · ");
      wrapper.append(contextCard("geology", "Geología", main, secondary, text(geology.status, "disponible")));
    }

    const astronomy = context?.astronomy;
    if (astronomy) {
      const targets = availableAstronomyTargets(astronomy, message, allowCurrentAstronomy);
      const reference = astronomy.reference_target || {};
      const available = astronomy.available_target_count ?? astronomy.target_count;
      const main = targets.length
        ? ""
        : reference.name
          ? `${astronomyIcon(reference)} ${reference.name}${reference.kind ? ` · ${reference.kind}` : ""}`
          : `${formatNumber(available, 0)} objetos disponibles`;
      const secondary = targets.length ? "" : astronomyPosition(reference);
      const extra = targets.length ? astronomyList(targets) : null;
      wrapper.append(contextCard("astronomy", "Astronomía", main, secondary, text(astronomy.status, "disponible"), extra));
    }

    const economy = context?.economy;
    if (economy) {
      const indicators = Array.isArray(economy.indicators) ? economy.indicators : [];
      const indicatorText = indicators.slice(0, 3).map((item) => `${text(item.label, "Indicador")}: ${text(item.value)}`).join(" · ");
      wrapper.append(contextCard("economy", "Economía", indicatorText || text(economy.date, "Contexto disponible"), text(economy.date, ""), text(economy.status, "disponible")));
    }

    if (!wrapper.children.length) wrapper.append(element("div", "sonantia-context-unavailable", "Este mensaje no incluye contexto factual adicional."));
    return wrapper;
  }

  function stableNumber(value) {
    let hash = 2166136261;
    for (const character of String(value || "mensaje")) {
      hash ^= character.codePointAt(0);
      hash = Math.imul(hash, 16777619);
    }
    return hash >>> 0;
  }

  function stableChoice(values, seed, offset = 0) {
    if (!Array.isArray(values) || !values.length) return "";
    return values[(stableNumber(`${seed}:${offset}`) + offset) % values.length];
  }

  function localHour(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return null;
    const formatter = new Intl.DateTimeFormat("es-CL", {
      hour:"2-digit", hour12:false, hourCycle:"h23", timeZone:localNode.timezone
    });
    const hour = Number(formatter.formatToParts(date).find((part) => part.type === "hour")?.value);
    return Number.isFinite(hour) ? hour : null;
  }

  function daypartKey(hour) {
    if (hour === null) return "unknown";
    if (hour < 5) return "dawn";
    if (hour < 8) return "early-morning";
    if (hour < 12) return "morning";
    if (hour < 15) return "midday";
    if (hour < 20) return "afternoon";
    if (hour < 23) return "evening";
    return "late-night";
  }

  function daypartPhrase(hour) {
    const phrases = {
      dawn: "durante esta madrugada",
      "early-morning": "en las primeras horas de la mañana",
      morning: "durante esta mañana",
      midday: "a esta hora del día",
      afternoon: "durante esta tarde",
      evening: "durante esta noche",
      "late-night": "en las últimas horas del día",
      unknown: "en este momento",
    };
    return phrases[daypartKey(hour)] || phrases.unknown;
  }

  function contextualGreetingOptions(weather, city) {
    const data = weather?.data || {};
    const temperature = data.temperature_c === null || data.temperature_c === undefined ? null : Number(data.temperature_c);
    const humidity = data.relative_humidity_percent === null || data.relative_humidity_percent === undefined ? null : Number(data.relative_humidity_percent);
    const options = [];
    if (Number.isFinite(temperature)) {
      if (temperature < 8) {
        options.push(
          `Con un ambiente frío, saludamos desde ${city}.`,
          `Desde ${city}, compartimos este registro en medio de una jornada fría.`
        );
      } else if (temperature < 14) {
        options.push(
          `En un ambiente fresco, volvemos a saludar desde ${city}.`,
          `Desde ${city}, compartimos este momento bajo condiciones frescas.`
        );
      } else if (temperature < 23) {
        options.push(
          `Con un ambiente templado, saludamos nuevamente desde ${city}.`,
          `Desde ${city}, compartimos este registro en un momento templado.`
        );
      } else if (temperature < 29) {
        options.push(
          `En una jornada cálida, saludamos desde ${city}.`,
          `Desde ${city}, compartimos este momento bajo un ambiente cálido.`
        );
      } else {
        options.push(
          `Con temperaturas elevadas, saludamos desde ${city}.`,
          `Desde ${city}, compartimos este registro en una jornada calurosa.`
        );
      }
    }
    if (Number.isFinite(humidity) && humidity >= 80) {
      options.push(
        `En medio de un ambiente muy húmedo, saludamos desde ${city}.`,
        `Desde ${city}, compartimos este momento con una humedad elevada.`
      );
    } else if (Number.isFinite(humidity) && humidity < 35) {
      options.push(
        `Bajo un ambiente seco, saludamos desde ${city}.`,
        `Desde ${city}, compartimos este registro con una humedad baja.`
      );
    }
    return options;
  }

  function localGreeting(value, city, seed, weather = null) {
    const hour = localHour(value);
    const safeCity = text(city, localNode.city);
    const greetings = {
      dawn: [
        `En esta madrugada saludamos desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos un nuevo registro de la madrugada.`,
        `A esta hora temprana, volvemos a saludar desde ${safeCity}.`,
        `Antes de comenzar la jornada, enviamos un saludo desde ${safeCity}.`,
        `Con la ciudad aún en calma, saludamos desde ${safeCity}.`,
        `Desde ${safeCity}, iniciamos este registro de madrugada.`,
        `Una nueva lectura comienza desde ${safeCity}.`,
        `En las primeras horas del día, saludamos desde ${safeCity}.`,
        `Durante esta madrugada, compartimos un saludo desde ${safeCity}.`,
        `Desde ${safeCity}, abrimos una nueva observación antes del amanecer.`,
      ],
      "early-morning": [
        `Buenos días desde ${safeCity}.`,
        `Comenzamos la mañana saludando desde ${safeCity}.`,
        `Desde ${safeCity}, damos la bienvenida a una nueva jornada.`,
        `En las primeras horas de la mañana, saludamos desde ${safeCity}.`,
        `Esta mañana volvemos a encontrarnos desde ${safeCity}.`,
        `Con el inicio del día, enviamos un saludo desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos la primera lectura de la jornada.`,
        `Una nueva mañana comienza y saludamos desde ${safeCity}.`,
        `En esta oportunidad, saludamos temprano desde ${safeCity}.`,
        `Al comenzar la jornada, transmitimos desde ${safeCity}.`,
      ],
      morning: [
        `Buenos días, nuevamente saludamos desde ${safeCity}.`,
        `Transmitimos esta mañana desde ${safeCity}.`,
        `En esta oportunidad saludamos desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos una nueva lectura de la mañana.`,
        `Continuamos la jornada con un saludo desde ${safeCity}.`,
        `Durante esta mañana, volvemos a saludar desde ${safeCity}.`,
        `Nos encontramos nuevamente esta mañana desde ${safeCity}.`,
        `Desde ${safeCity}, acompañamos la mañana con un nuevo registro.`,
        `La jornada continúa y saludamos desde ${safeCity}.`,
        `Compartimos este momento de la mañana desde ${safeCity}.`,
        `Una vez más, enviamos un saludo matinal desde ${safeCity}.`,
        `Desde ${safeCity}, retomamos la jornada con una nueva observación.`,
      ],
      midday: [
        `Buenas tardes desde ${safeCity}.`,
        `Al llegar el mediodía, saludamos desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos una nueva lectura del mediodía.`,
        `En esta oportunidad saludamos desde ${safeCity}.`,
        `Transmitimos a esta hora desde ${safeCity}.`,
        `Con la jornada en pleno desarrollo, saludamos desde ${safeCity}.`,
        `Desde ${safeCity}, hacemos una pausa para compartir este registro.`,
        `Durante las horas centrales del día, saludamos desde ${safeCity}.`,
        `Compartimos este momento de la jornada desde ${safeCity}.`,
        `Desde ${safeCity}, continuamos con una nueva observación.`,
        `A esta hora, volvemos a encontrarnos desde ${safeCity}.`,
        `La jornada alcanza su punto medio y saludamos desde ${safeCity}.`,
      ],
      afternoon: [
        `Buenas tardes desde ${safeCity}.`,
        `Transmitimos esta tarde desde ${safeCity}.`,
        `Nuevamente saludamos esta tarde desde ${safeCity}.`,
        `En esta oportunidad, volvemos a saludar desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos una nueva lectura de la tarde.`,
        `La jornada avanza y saludamos desde ${safeCity}.`,
        `Durante esta tarde, compartimos un nuevo registro desde ${safeCity}.`,
        `Volvemos a encontrarnos esta tarde desde ${safeCity}.`,
        `Desde ${safeCity}, acompañamos el avance de la jornada.`,
        `Compartimos este momento de la tarde desde ${safeCity}.`,
        `La tarde continúa y enviamos un saludo desde ${safeCity}.`,
        `Desde ${safeCity}, retomamos el contacto con una nueva observación.`,
        `En medio de la tarde, saludamos nuevamente desde ${safeCity}.`,
        `A esta hora de la tarde, compartimos un saludo desde ${safeCity}.`,
      ],
      evening: [
        `Buenas noches desde ${safeCity}.`,
        `Buenas noches, nuevamente saludamos desde ${safeCity}.`,
        `Esta noche volvemos a saludar desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos el registro de esta noche.`,
        `Al finalizar la jornada, saludamos desde ${safeCity}.`,
        `Con la llegada de la noche, enviamos un saludo desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos una nueva lectura nocturna.`,
        `La jornada entra en su tramo final y saludamos desde ${safeCity}.`,
        `Durante esta noche, volvemos a encontrarnos desde ${safeCity}.`,
        `Desde ${safeCity}, cerramos el día con un nuevo registro.`,
        `Al caer la noche, compartimos un saludo desde ${safeCity}.`,
        `La noche comienza y volvemos a saludar desde ${safeCity}.`,
      ],
      "late-night": [
        `Buenas noches desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos una lectura de las últimas horas del día.`,
        `A esta hora de la noche, volvemos a saludar desde ${safeCity}.`,
        `Con la ciudad en calma, compartimos este registro desde ${safeCity}.`,
        `Antes de cerrar el día, enviamos un saludo desde ${safeCity}.`,
        `Desde ${safeCity}, acompañamos las últimas horas de la jornada.`,
        `En esta noche avanzada, saludamos desde ${safeCity}.`,
        `Un nuevo registro nocturno comienza desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos esta observación antes del descanso.`,
        `En las últimas horas del día, volvemos a encontrarnos desde ${safeCity}.`,
      ],
      unknown: [
        `Saludos desde ${safeCity}.`,
        `En esta oportunidad saludamos desde ${safeCity}.`,
        `Desde ${safeCity}, compartimos un nuevo registro.`,
        `Nuevamente nos encontramos desde ${safeCity}.`,
        `Transmitimos una nueva observación desde ${safeCity}.`,
        `Desde ${safeCity}, enviamos un saludo y compartimos esta lectura.`,
      ],
    };
    const key = daypartKey(hour);
    const options = [
      ...(greetings[key] || greetings.unknown),
      ...contextualGreetingOptions(weather, safeCity),
    ];
    return stableChoice(options, seed, 3);
  }

  function messageSentences(value) {
    const cleaned = String(value || "")
      .replace(/\s*\((?:referencias?|referencia ambiental|movimiento telúrico)[\s\S]*?\)\s*$/giu, "")
      .trim();
    return cleaned.match(/[^.!?]+[.!?]+|[^.!?]+$/g)?.map((item) => item.trim()).filter(Boolean) || [];
  }

  function isContextSentence(value) {
    const normalized = String(value || "").toLocaleLowerCase("es-CL");
    return /temperatura|humedad|presión|hpa|radiación|lluvia|precipitación|azimut|elevación|telúr|sismo|astro|meteorológ/.test(normalized);
  }

  function stripEditorialPrefix(value) {
    let cleaned = String(value || "").replace(/[.!?]+$/u, "").trim();
    const patterns = [
      /^(?:la señal del nodo|la publicación|el mensaje|el nodo|sonantia)\s+(?:resuena|transmite|comunica|acompaña|destaca|expresa|refuerza|recuerda)\s+(?:(?:con|mediante)\s+)?(?:(?:la|una)\s+)?(?:idea|afirmación|reflexión|declaración|certeza|mensaje)?\s*(?:de\s+)?que\s+/iu,
      /^(?:junto con estos datos|con esta lectura del entorno|con esta lectura|con este registro|a partir de esta observación|a partir de esta lectura|en este registro|durante este ciclo|para este ciclo|este registro|la lectura disponible|la observación local)[,:]?\s*(?:declaramos|dejamos constancia|afirmamos|señalamos|expresamos|acompaña|refuerza|transmite|comunica|destaca|indica|permite expresar)\s+(?:(?:la|una)\s+)?(?:idea|afirmación|reflexión|declaración|certeza|mensaje)?\s*(?:de\s+)?que\s+/iu,
      /^(?:junto con estos datos|con esta lectura del entorno|con esta lectura|con este registro|a partir de esta observación|a partir de esta lectura|en este registro|durante este ciclo|para este ciclo|este registro)[,:]?\s*(?:la idea|la afirmación|el mensaje)\s+(?:de\s+)?que\s+/iu,
      /^(?:declaramos|dejamos constancia|afirmamos|señalamos|expresamos|destacamos|recordamos)\s+(?:la idea\s+)?(?:de\s+)?que\s+/iu,
    ];
    for (let pass = 0; pass < 3; pass += 1) {
      const previous = cleaned;
      for (const pattern of patterns) cleaned = cleaned.replace(pattern, "").trim();
      if (cleaned === previous) break;
    }
    return cleaned.replace(/^[,;:\-–—\s]+/u, "").trim();
  }

  function polishAffirmation(value) {
    let polished = stripEditorialPrefix(value);
    polished = polished
      .replace(/\bpara convertir ideas en proyectos viables genera proyectos con posibilidades reales de éxito\b/giu, "para convertir ideas en proyectos viables abre posibilidades reales de éxito")
      .replace(/\bproyectos viables generan proyectos\b/giu, "proyectos viables generan iniciativas")
      .replace(/\s+([,.;:!?])/gu, "$1")
      .replace(/\s{2,}/gu, " ")
      .trim();
    if (!polished) return "";
    return polished.charAt(0).toLocaleUpperCase("es-CL") + polished.slice(1);
  }

  function affirmationFromMessage(message) {
    const generatedAffirmation = message?.generator?.affirmation_text;
    if (generatedAffirmation) return polishAffirmation(generatedAffirmation);
    const sentences = messageSentences(message?.text);
    let selected = [...sentences].reverse().find((sentence) => /David Alexander Bijman Molina/i.test(sentence));
    if (!selected) selected = [...sentences].reverse().find((sentence) => !isContextSentence(sentence));
    return polishAffirmation(selected || "");
  }

  function weatherDescription(temperature, humidity) {
    const temperatureLabel = temperature < 8
      ? "frío"
      : temperature < 14
        ? "fresco"
        : temperature < 23
          ? "templado"
          : temperature < 29
            ? "cálido"
            : "caluroso";
    const humidityLabel = humidity < 35
      ? "seco"
      : humidity < 60
        ? "de humedad moderada"
        : humidity < 80
          ? "húmedo"
          : "muy húmedo";
    return `${temperatureLabel} y ${humidityLabel}`;
  }

  function weatherSentence(weather, city, seed, messageTime = null) {
    const data = weather?.data || {};
    const temperature = data.temperature_c === null || data.temperature_c === undefined ? null : Number(data.temperature_c);
