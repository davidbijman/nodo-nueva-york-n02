{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonantia.network/schemas/feed-1.0.schema.json",
  "title": "Feed propio de Red Sonantia Network v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network_id",
    "protocol_version",
    "network_epoch",
    "document_type",
    "node_id",
    "generated_at",
    "feed_limit",
    "message_count",
    "messages"
  ],
  "properties": {
    "network_id": {
      "const": "sonantia-network"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "network_epoch": {
      "pattern": "^SN1-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "document_type": {
      "const": "feed"
    },
    "node_id": {
      "pattern": "^N[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "feed_limit": {
      "type": "integer",
      "minimum": 1
    },
    "message_count": {
      "type": "integer",
      "minimum": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "https://sonantia.network/schemas/message-1.0.schema.json"
      }
    }
  }
}
