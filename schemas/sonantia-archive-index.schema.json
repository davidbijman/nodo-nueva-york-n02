{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonantia.network/schemas/archive-index-1.0.schema.json",
  "title": "Índices de archivo de Red Sonantia Network v1.0",
  "oneOf": [
    {"$ref": "#/$defs/globalIndex"},
    {"$ref": "#/$defs/monthlyIndex"}
  ],
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "network_id": {"const": "sonantia-network"},
        "protocol_version": {"const": "1.0"},
        "network_epoch": {"pattern": "^SN1-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "origin_node_id": {"pattern": "^N[0-9]{2}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "message_count": {"type": "integer", "minimum": 0},
        "first_sequence": {"type": ["integer", "null"], "minimum": 1},
        "last_sequence": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "globalIndex": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_id",
            "protocol_version",
            "network_epoch",
            "document_type",
            "origin_node_id",
            "generated_at",
            "message_count",
            "first_sequence",
            "last_sequence",
            "months"
          ],
          "properties": {
            "network_id": {"const": "sonantia-network"},
            "protocol_version": {"const": "1.0"},
            "network_epoch": {"pattern": "^SN1-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "document_type": {"const": "archive-index"},
            "origin_node_id": {"pattern": "^N[0-9]{2}$"},
            "generated_at": {"type": "string", "format": "date-time"},
            "message_count": {"type": "integer", "minimum": 0},
            "first_sequence": {"type": ["integer", "null"], "minimum": 1},
            "last_sequence": {"type": ["integer", "null"], "minimum": 1},
            "months": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "period",
                  "path",
                  "message_count",
                  "first_sequence",
                  "last_sequence"
                ],
                "properties": {
                  "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
                  "path": {"type": "string", "minLength": 1},
                  "message_count": {"type": "integer", "minimum": 0},
                  "first_sequence": {"type": ["integer", "null"], "minimum": 1},
                  "last_sequence": {"type": ["integer", "null"], "minimum": 1}
                }
              }
            }
          }
        }
      ]
    },
    "monthlyIndex": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_id",
            "protocol_version",
            "network_epoch",
            "document_type",
            "origin_node_id",
            "generated_at",
            "period",
            "message_count",
            "first_sequence",
            "last_sequence",
            "days"
          ],
          "properties": {
            "network_id": {"const": "sonantia-network"},
            "protocol_version": {"const": "1.0"},
            "network_epoch": {"pattern": "^SN1-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "document_type": {"const": "monthly-archive-index"},
            "origin_node_id": {"pattern": "^N[0-9]{2}$"},
            "generated_at": {"type": "string", "format": "date-time"},
            "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
            "message_count": {"type": "integer", "minimum": 0},
            "first_sequence": {"type": ["integer", "null"], "minimum": 1},
            "last_sequence": {"type": ["integer", "null"], "minimum": 1},
            "days": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "path",
                  "message_count",
                  "first_sequence",
                  "last_sequence"
                ],
                "properties": {
                  "date": {"type": "string", "format": "date"},
                  "path": {"type": "string", "minLength": 1},
                  "message_count": {"type": "integer", "minimum": 0},
                  "first_sequence": {"type": ["integer", "null"], "minimum": 1},
                  "last_sequence": {"type": ["integer", "null"], "minimum": 1}
                }
              }
            }
          }
        }
      ]
    }
  }
}
