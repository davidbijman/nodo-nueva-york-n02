{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonantia.network/schemas/node-1.0.schema.json",
  "title": "Perfil local de un nodo Sonantia 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "document_type", "node_id", "display_name", "node_role",
    "network_membership", "logical_location", "infrastructure", "context_sources",
    "public_url", "endpoints", "capabilities", "software"
  ],
  "$defs": {
    "contextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "provider", "settings"],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "settings": {"type": "object"}
      }
    }
  },
  "properties": {
    "protocol_version": {"const": "1.0"},
    "document_type": {"const": "node"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{2}$"},
    "display_name": {"type": "string", "minLength": 1},
    "node_role": {"const": "publisher-replicator"},
    "network_membership": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "joined_at"],
      "properties": {
        "status": {"enum": ["active", "inactive"]},
        "joined_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "logical_location": {
      "type": "object", "additionalProperties": false,
      "required": ["zone", "country", "country_code", "city", "timezone", "latitude", "longitude", "elevation_m"],
      "properties": {
        "zone": {"type": "string", "minLength": 1},
        "country": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "city": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "elevation_m": {"type": "number", "minimum": -500, "maximum": 10000}
      }
    },
    "infrastructure": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "automation", "hosting", "region_status", "region_description"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "automation": {"type": "string", "minLength": 1},
        "hosting": {"type": "string", "minLength": 1},
        "region_status": {"type": "string", "minLength": 1},
        "region_description": {"type": "string", "minLength": 1}
      }
    },
    "context_sources": {
      "type": "object", "additionalProperties": false,
      "required": ["weather", "astronomy", "economy", "geology"],
      "properties": {
        "weather": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "provider", "mode", "condition_provider", "settings"],
          "properties": {
            "enabled": {"type": "boolean"},
            "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "mode": {"enum": ["single", "composite"]},
            "condition_provider": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "settings": {"type": "object"}
          }
        },
        "astronomy": {"$ref": "#/$defs/contextSource"},
        "economy": {"$ref": "#/$defs/contextSource"},
        "geology": {"$ref": "#/$defs/contextSource"}
      }
    },
    "public_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "endpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["home", "feed", "status", "interactions", "archive_index", "operator_message"],
      "properties": {
        "home": {"type": "string"},
        "feed": {"const": "/feed.json"},
        "status": {"const": "/sonantia-status.json"},
        "interactions": {"const": "/sonantia.html#interacciones"},
        "archive_index": {"const": "/archive/index.json"},
        "operator_message": {"const": "/operator-message.json"}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["publish_original_messages", "replicate_messages", "poll_peers", "query_weather", "publish_html", "publish_json", "publish_operator_message", "user_message_board", "private_messages", "content_types"],
      "properties": {
        "publish_original_messages": {"type": "boolean"},
        "replicate_messages": {"type": "boolean"},
        "poll_peers": {"type": "boolean"},
        "query_weather": {"type": "boolean"},
        "publish_html": {"type": "boolean"},
        "publish_json": {"type": "boolean"},
        "publish_operator_message": {"type": "boolean"},
        "user_message_board": {"const": false},
        "private_messages": {"const": false},
        "content_types": {"type": "array", "items": {"enum": ["text/plain", "text/html", "application/json"]}, "uniqueItems": true}
      }
    },
    "software": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "implementation_version"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
