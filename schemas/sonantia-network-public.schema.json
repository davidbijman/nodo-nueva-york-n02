{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonantia.network/schemas/network-public-1.0.schema.json",
  "title": "Topología pública de Sonantia Network 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["network_id", "network_name", "protocol_name", "protocol_version", "network_epoch", "document_type", "generated_at", "reference_node_id", "reference_node_name", "platform", "implementation_state", "nodes"],
  "properties": {
    "network_id": {"const": "sonantia-network"},
    "network_name": {"const": "Sonantia Network"},
    "protocol_name": {"const": "Red Sonantia Network"},
    "protocol_version": {"const": "1.0"},
    "network_epoch": {"pattern": "^SN1-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "document_type": {"const": "network"},
    "generated_at": {"type": "string", "format": "date-time"},
    "reference_node_id": {"pattern": "^N[0-9]{2}$"},
    "reference_node_name": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "implementation_state": {"const": "active"},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "display_name", "platform", "enabled", "public_url", "feed_url", "status_url"],
        "properties": {
          "node_id": {"pattern": "^N[0-9]{2}$"},
          "display_name": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "public_url": {"type": "string", "format": "uri"},
          "feed_url": {"type": "string", "format": "uri"},
          "status_url": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
