{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonantia.network/schemas/interactions-1.0.schema.json",
  "title": "Interacciones compactas de Red Sonantia Network v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network_id",
    "protocol_version",
    "network_epoch",
    "document_type",
    "node_id",
    "generated_at",
    "limit",
    "event_count",
    "events"
  ],
  "properties": {
    "network_id": {"const": "sonantia-network"},
    "protocol_version": {"const": "1.0"},
    "network_epoch": {"pattern": "^SN1-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "document_type": {"const": "interactions"},
    "node_id": {"pattern": "^N[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "limit": {"type": "integer", "minimum": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "occurred_at", "result"],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^SN1-N[0-9]{2}-EVT-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z-[0-9]{6}$"
          },
          "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "result": {
            "enum": ["success", "duplicate", "rejected", "degraded", "failed"]
          },
          "message_id": {
            "type": "string",
            "pattern": "^SN1-N[0-9]{2}-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z-[0-9]{6}$"
          },
          "peer_node_id": {"type": "string", "pattern": "^N[0-9]{2}$"},
          "details": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
