{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distributed-node.example/schemas/message-catalog.schema.json",
  "title": "Catálogo interno de mensajes Sonantia 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "generator_id",
    "default_language",
    "selection_policy",
    "recipient_names",
    "policy",
    "openings",
    "declarations",
    "fallback_messages",
    "source_templates",
    "phrase_collections"
  ],
  "properties": {
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "generator_id": {
      "$ref": "#/$defs/identifier"
    },
    "default_language": {
      "const": "es"
    },
    "selection_policy": {
      "const": "deterministic_factorized"
    },
    "recipient_names": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_order",
        "max_source_sections",
        "weather_fact_count",
        "max_message_characters"
      ],
      "properties": {
        "source_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "max_source_sections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "weather_fact_count": {
          "const": 2
        },
        "max_message_characters": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      }
    },
    "openings": {
      "$ref": "#/$defs/weightedValues"
    },
    "declarations": {
      "$ref": "#/$defs/weightedValues"
    },
    "fallback_messages": {
      "$ref": "#/$defs/weightedValues"
    },
    "source_templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "templates"
        ],
        "properties": {
          "source_id": {
            "$ref": "#/$defs/identifier"
          },
          "enabled": {
            "type": "boolean"
          },
          "templates": {
            "$ref": "#/$defs/weightedValues"
          }
        }
      }
    },
    "phrase_collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection_id",
          "path"
        ],
        "properties": {
          "collection_id": {
            "$ref": "#/$defs/identifier"
          },
          "enabled": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "pattern": "^phrases/[a-z0-9_]+\\.txt$"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_id",
        "weight",
        "text"
      ],
      "properties": {
        "value_id": {
          "$ref": "#/$defs/identifier"
        },
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)+$"
          }
        }
      }
    },
    "weightedValues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/value"
      }
    }
  }
}
